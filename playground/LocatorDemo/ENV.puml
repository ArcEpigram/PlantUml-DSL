''----------------------------------------------------------------------------------------------------------------------
'' ENV.puml — переменные окружения для Locator.
'' Подключите этот файл в диаграмме первым, перед !include Context.puml.
'' Задаёт корневые каталоги для каждого типа архитектурных элементов.
''
'' Использование:
''   !include ENV.puml
''   !include ../../src/C4/Context.puml
''   ... Диаграмма ...
''
'' Переменные:
''   LOCATOR_PERSONS_ROOT    — корень для Persons  (*.person.puml)
''   LOCATOR_SYSTEMS_ROOT    — корень для Systems   (*.system.puml)
''   LOCATOR_BOUNDARIES_ROOT — корень для Boundaries (*.boundary.puml)
''   LOCATOR_RELATIONS_ROOT  — корень для Relations  (*.relation.puml)
''----------------------------------------------------------------------------------------------------------------------
%set_variable_value("LOCATOR_PERSONS_ROOT", "../../playground/LocatorDemo/Elements/Persons")
%set_variable_value("LOCATOR_SYSTEMS_ROOT", "../../playground/LocatorDemo/Elements/Systems")
%set_variable_value("LOCATOR_BOUNDARIES_ROOT", "../../playground/LocatorDemo/Elements/Boundaries")
%set_variable_value("LOCATOR_RELATIONS_ROOT", "../../playground/LocatorDemo/Elements/Relations")