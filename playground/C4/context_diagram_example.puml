HideDescription(User-Admin)
ApplyStyle(User-Admin, "firewall")
ApplySprite(User-Admin, "&key")

''-----------------------------------------------------------------------
'' Настройка диаграммы и рендеринг
''-----------------------------------------------------------------------
Diagram($title="System Context diagram", ...)

@enduml
