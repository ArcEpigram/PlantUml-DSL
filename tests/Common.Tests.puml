@startuml
!include ../src/Common.puml
''----------------------------------------------------------------------------------------------------------------------
'' Tests
''----------------------------------------------------------------------------------------------------------------------
!procedure register_descriptor_should_save_and_retrieve()
    '' Arrange
    !$alias = "TestUser"
    !$descriptor = {"type":"Test","label":"TestLabel"}

    '' Act
    $register_descriptor($alias, $descriptor)
    !$actual = $get_descriptor($alias)

    '' Assert
    !assert $actual.type == "Test"
    !assert $actual.label == "TestLabel"
!endprocedure
''----------------------------------------------------------------------------------------------------------------------
!procedure get_descriptor_should_return_empty_for_missing_alias()
    '' Arrange, Act
    !$actual = $get_descriptor("NonExistent")

    '' Assert
    !assert %size($actual) == 0
!endprocedure
''----------------------------------------------------------------------------------------------------------------------
!procedure has_descriptor_should_return_true_for_registered_alias()
    '' Arrange
    !$desc = {}
    !$desc = $json_add($desc, "type", "X")
    $register_descriptor("Exists", $desc)

    '' Act
    !$actual = $has_descriptor("Exists")

    '' Assert
    !assert $actual == %true()
!endprocedure
''----------------------------------------------------------------------------------------------------------------------
!procedure has_descriptor_should_return_false_for_missing_alias()
    '' Arrange, Act
    !$actual = $has_descriptor("NoSuch")

    '' Assert
    !assert $actual == %false()
!endprocedure
''----------------------------------------------------------------------------------------------------------------------
!procedure register_decorator_should_save_and_retrieve()
    '' Arrange
    !$decorator = {}
    !$decorator = $json_add($decorator, "is_extern", %false())
    !$decorator = $json_add($decorator, "show_desc", %true())
    !$decorator = $json_add($decorator, "styles", ["bold"])

    '' Act
    $register_decorator("DC", $decorator)
    !$actual = $get_decorator("DC")

    '' Assert
    !assert $actual.is_extern == %false()
    !assert $actual.show_desc == %true()
    !assert $actual.styles[0] == "bold"
!endprocedure
''----------------------------------------------------------------------------------------------------------------------
!procedure update_decorator_should_modify_specific_field()
    '' Arrange
    !$decorator = {}
    !$decorator = $json_add($decorator, "is_extern", %false())
    !$decorator = $json_add($decorator, "show_desc", %true())
    $register_decorator("UPD", $decorator)

    '' Act
    $update_decorator("UPD", "show_desc", %false())
    !$actual = $get_decorator("UPD")

    '' Assert
    !assert $actual.show_desc == %false()
    !assert $actual.is_extern == %false()
!endprocedure
''----------------------------------------------------------------------------------------------------------------------
!procedure add_to_queue_should_append_alias()
    '' Arrange
    $reset_rendering_queue()

    '' Act
    $add_to_rendering_queue("Alice")
    !$queue = $get_rendering_queue()

    '' Assert
    !assert %size($queue) == 1
    !assert $queue[0] == "Alice"
!endprocedure
''----------------------------------------------------------------------------------------------------------------------
!procedure add_to_queue_should_not_duplicate_alias()
    '' Arrange
    $reset_rendering_queue()
    $add_to_rendering_queue("Bob")

    '' Act
    $add_to_rendering_queue("Bob")
    !$queue = $get_rendering_queue()

    '' Assert
    !assert %size($queue) == 1
!endprocedure
''----------------------------------------------------------------------------------------------------------------------
!procedure reset_queue_should_clear_all_entries()
    '' Arrange
    $add_to_rendering_queue("X")
    $add_to_rendering_queue("Y")

    '' Act
    $reset_rendering_queue()
    !$queue = $get_rendering_queue()

    '' Assert
    !assert %size($queue) == 0
!endprocedure
''----------------------------------------------------------------------------------------------------------------------
'' Tests RUN!
''----------------------------------------------------------------------------------------------------------------------
register_descriptor_should_save_and_retrieve()
get_descriptor_should_return_empty_for_missing_alias()
has_descriptor_should_return_true_for_registered_alias()
has_descriptor_should_return_false_for_missing_alias()
register_decorator_should_save_and_retrieve()
update_decorator_should_modify_specific_field()
add_to_queue_should_append_alias()
add_to_queue_should_not_duplicate_alias()
reset_queue_should_clear_all_entries()
''----------------------------------------------------------------------------------------------------------------------
caption OK
@enduml
