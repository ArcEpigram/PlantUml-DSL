    !$descriptor = $json_add($descriptor, "type", "Container")
    !$descriptor = $json_add($descriptor, "element_type", "")
    !$descriptor = $json_add($descriptor, "label", "MyLabel")
    !$descriptor = $json_add($descriptor, "techn", "Java + Spring")
