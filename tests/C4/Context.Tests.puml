''----------------------------------------------------------------------------------------------------------------------
!procedure resolve_relation_render_params_joins_styles_as_tags()
    '' Arrange
    !$desc = {}
    !$desc = $json_add($desc, "type", "Relation")
    !$desc = $json_add($desc, "from", "A")
    !$desc = $json_add($desc, "to", "B")
    !$desc = $json_add($desc, "label", "L")
    !$decor = {}
    !$decor = $json_add($decor, "show_label", %true())
    !$decor = $json_add($decor, "show_techn", %true())
    !$decor = $json_add($decor, "show_descr", %true())
    !$decor = $json_add($decor, "link", "")
    !$decor = $json_add($decor, "sprite", "")
    !$decor = $json_add($decor, "styles", [])
    !$decor = $json_set($decor, "styles", $append_to_list($decor.styles, "a"))
    !$decor = $json_set($decor, "styles", $append_to_list($decor.styles, "b"))

    '' Act
    !$params = $resolve_relation_render_params($desc, $decor)

    '' Assert
    !assert $params.tags == "a+b"
!endprocedure
