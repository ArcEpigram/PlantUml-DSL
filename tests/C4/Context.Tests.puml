'' Tests for Persons inclusion
''----------------------------------------------------------------------------------------------------------------------
!procedure persons_should_add_registered_alias_to_rendering_queue()
    '' Arrange
    $reset_rendering_queue()

    '' Act
    $include_elements("person", "TestPersons", "Alice", %false())
    !$queue = $get_rendering_queue()

    '' Assert
    !assert %size($queue) == 1
    !assert $queue[0] == "Alice"
!endprocedure
''----------------------------------------------------------------------------------------------------------------------
!procedure persons_should_skip_unregistered_alias()
    '' Arrange
    $reset_rendering_queue()

    '' Act — $include_elements с пустым source не выполняет !include
    $include_elements("person", "", "Ghost", %false())
    !$queue = $get_rendering_queue()

    '' Assert
    !assert %size($queue) == 0
!endprocedure
