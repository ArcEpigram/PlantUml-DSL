@startuml
!include ../../src/C4/Context.puml
''----------------------------------------------------------------------------------------------------------------------
'' Tests
''----------------------------------------------------------------------------------------------------------------------
!procedure person_registration_should_create_descriptor_with_person_type()
    '' Arrange, Act
    $Person("Test", "TestLabel")
    !$desc_str = $get_descriptor("Test")
    !$desc = $str2json($desc_str, $without_quotes = %true())

    '' Assert
    !assert $desc.type == "Person"
    !assert $desc.label == "TestLabel"
!endprocedure
''----------------------------------------------------------------------------------------------------------------------
!procedure person_registration_should_create_decorator_with_defaults()
    '' Arrange
    $Person("Def", "Default")

    '' Act — декоратор создаётся при включении в диаграмму
    $include_elements("person", "TestPersons", "Def", %false())
    !$decor = $get_decorator("Def")

    '' Assert
    !assert $decor.is_extern == %false()
    !assert $decor.show_desc == %true()
    !assert $default($decor.sprite) == ""
    !assert %size($decor.styles) == 0
!endprocedure
''----------------------------------------------------------------------------------------------------------------------
!procedure person_registration_should_save_description()
    '' Arrange, Act
    $Person("Desc", "WithDesc", "Описание")
    !$desc_str = $get_descriptor("Desc")
    !$desc = $str2json($desc_str, $without_quotes = %true())

    '' Assert
    !assert $desc.desc == "Описание"
!endprocedure
''----------------------------------------------------------------------------------------------------------------------
!procedure person_registration_should_save_tags()
    '' Arrange, Act
    $Person("Tagged", "T", "", "", "critical+external")
