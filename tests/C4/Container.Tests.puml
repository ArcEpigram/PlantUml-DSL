''----------------------------------------------------------------------------------------------------------------------
'' Tests for global auto-sprite toggle (SHOW_TECH_SPRITE_AUTO/HIDE_TECH_SPRITE_AUTO)
''----------------------------------------------------------------------------------------------------------------------
!procedure resolve_container_render_params_should_not_auto_resolve_when_disabled()
    '' Arrange — отключаем авто-подбор
    HIDE_TECH_SPRITE_AUTO()
    !$descriptor = {}
    !$descriptor = $json_add($descriptor, "type", "Container")
    !$descriptor = $json_add($descriptor, "element_type", "")
    !$descriptor = $json_add($descriptor, "label", "Payments")
    !$descriptor = $json_add($descriptor, "techn", "Java 17 + Spring Boot")
    !$descriptor = $json_add($descriptor, "desc", "")
    !$descriptor = $json_add($descriptor, "sprite", "")
    !$descriptor = $json_add($descriptor, "tags", "")
    !$descriptor = $json_add($descriptor, "link", "")
    !$descriptor = $json_add($descriptor, "baseShape", "")
    !$decorator = {}
    !$decorator = $json_add($decorator, "is_extern", %false())
    !$decorator = $json_add($decorator, "show_desc", %true())
    !$decorator = $json_add($decorator, "sprite", "")
    !$decorator = $json_add($decorator, "styles", [])

    '' Act
    !$params = $resolve_container_render_params($descriptor, $decorator)

    '' Assert — спрайт пустой, хотя технология известна
    !assert $default($params.sprite) == ""

    '' Cleanup — восстанавливаем дефолт (ВКЛ) для последующих тестов
    SHOW_TECH_SPRITE_AUTO()
!endprocedure
