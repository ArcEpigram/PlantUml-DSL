!procedure resolve_container_render_params_should_map_default_to_container()
    '' Arrange
    !$descriptor = {}
    !$descriptor = $json_add($descriptor, "type", "Container")
    !$descriptor = $json_add($descriptor, "element_type", "")
    !$descriptor = $json_add($descriptor, "label", "L")
    !$descriptor = $json_add($descriptor, "techn", "T")
    !$descriptor = $json_add($descriptor, "desc", "D")
    !$descriptor = $json_add($descriptor, "sprite", "")
    !$descriptor = $json_add($descriptor, "tags", "")
    !$descriptor = $json_add($descriptor, "link", "")
    !$descriptor = $json_add($descriptor, "baseShape", "hexagon")
    !$decorator = {}
    !$decorator = $json_add($decorator, "is_extern", %false())
    !$decorator = $json_add($decorator, "show_desc", %true())
    !$decorator = $json_add($decorator, "sprite", "")
    !$decorator = $json_add($decorator, "styles", [])

    '' Act
    !$params = $resolve_container_render_params($descriptor, $decorator)

    '' Assert
    !assert $params.render_proc == "Container"
    !assert $params.baseShape == "hexagon"
!endprocedure
