!endprocedure

!procedure sprite_from_tech_should_return_sprite_for_kafka()
    !$sprite = $get_sprite_from_technologies("Kafka")
    !assert $sprite == "kafka"
!endprocedure

!procedure sprite_from_tech_should_return_sprite_for_redis()
    !$sprite = $get_sprite_from_technologies("Redis 7")
