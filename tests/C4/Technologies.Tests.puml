''--------------------
'' $__tech_sprite_auto_enabled / SHOW_TECH_SPRITE_AUTO / HIDE_TECH_SPRITE_AUTO
''--------------------
!procedure tech_sprite_auto_should_be_enabled_by_default()
    '' Arrange — флаг не установлен, состояние по умолчанию
    !assert $__tech_sprite_auto_enabled() == %true()
!endprocedure

!procedure hide_tech_sprite_auto_should_turn_flag_off()
    '' Arrange, Act
    HIDE_TECH_SPRITE_AUTO()
    !assert $__tech_sprite_auto_enabled() == %false()
    '' Cleanup — восстанавливаем дефолтное состояние для последующих тестов
    SHOW_TECH_SPRITE_AUTO()
!endprocedure

!procedure show_tech_sprite_auto_should_turn_flag_on()
    '' Arrange
    HIDE_TECH_SPRITE_AUTO()
    !assert $__tech_sprite_auto_enabled() == %false()

    '' Act
    SHOW_TECH_SPRITE_AUTO()

    '' Assert
    !assert $__tech_sprite_auto_enabled() == %true()
!endprocedure

''--------------------
'' SET_SPRITES_MAP
''--------------------
'' Возвращает путь к тестовой фикстуре каталога технологий.
'' На Linux %file_exists/%load_json не резолвят относительный путь от cwd,
'' поэтому в CI используется абсолютный путь из GITHUB_WORKSPACE; локально —
'' относительный путь от корня репозитория.
!function $__tech_override_fixture_path()
    !$ws = %getenv("GITHUB_WORKSPACE")
    !if $ws != ""
        !return $format("%1/tests/C4/technologies_override.json", $ws)
    !endif
    !return "tests/C4/technologies_override.json"
!endfunction

!procedure set_sprites_map_should_load_catalog_from_explicit_path()
    '' Arrange — явный путь к пользовательскому каталогу
    !$fixture = $__tech_override_fixture_path()
    SET_SPRITES_MAP($fixture)

    '' Act
    !$cat = $__tech_catalog()

    '' Assert — каталог загружен из указанного пути (2 записи, а не 21 встроенных)
    !assert %size($cat) == 2
    !$rec = $__find_tech($cat, "custom framework")
    !assert $rec.canonical == "Custom Framework"

    '' Cleanup — сброс переопределения
    SET_SPRITES_MAP("")
!endprocedure

!procedure set_sprites_map_should_take_priority_over_default()
    '' Arrange — SET_SPRITES_MAP должен переопределить встроенный каталог
    !$fixture = $__tech_override_fixture_path()
    SET_SPRITES_MAP($fixture)
    !$cat = $__tech_catalog()

    '' Assert — используется переопределённый каталог, а не встроенный (21 запись)
    !assert %size($cat) == 2

    '' Cleanup — сброс переопределения
    SET_SPRITES_MAP("")
!endprocedure
