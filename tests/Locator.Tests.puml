@startuml
!include ../src/Locator.puml
''----------------------------------------------------------------------------------------------------------------------
'' Tests for Locator module
''----------------------------------------------------------------------------------------------------------------------
!procedure locate_relation_should_resolve_top_level_path()
    %set_variable_value("LOCATOR_RELATIONS_ROOT", "../Elements/Relations")
    !$actual = $locate_relation("Manager-ERP")
    !assert $actual == "../Elements/Relations/Manager-ERP.relation.puml"
!endprocedure
''----------------------------------------------------------------------------------------------------------------------
!procedure locate_element_should_resolve_person_path()
    %set_variable_value("LOCATOR_PERSONS_ROOT", "../Elements/Persons")
    !$actual = $locate_element("person", "Manager")
    !assert $actual == "../Elements/Persons/Manager.person.puml"
!endprocedure
''----------------------------------------------------------------------------------------------------------------------
!procedure locate_element_should_resolve_system_path()
    %set_variable_value("LOCATOR_SYSTEMS_ROOT", "../Elements/Systems")
    !$actual = $locate_element("system", "ERP")
    !assert $actual == "../Elements/Systems/ERP.system.puml"
!endprocedure
''----------------------------------------------------------------------------------------------------------------------
!procedure locate_element_should_resolve_boundary_path()
    %set_variable_value("LOCATOR_BOUNDARIES_ROOT", "../Elements/Boundaries")
    !$actual = $locate_element("boundary", "Enterprise")
    !assert $actual == "../Elements/Boundaries/Enterprise.boundary.puml"
!endprocedure
''----------------------------------------------------------------------------------------------------------------------
!procedure locate_relation_should_resolve_path_inside_system()
    %set_variable_value("LOCATOR_SYSTEMS_ROOT", "../Elements/Systems")
    !$actual = $locate_relation("API-SSO", "ERP")
    !assert $actual == "../Elements/Systems/ERP/Relations/API-SSO.relation.puml"
!endprocedure
''----------------------------------------------------------------------------------------------------------------------
!procedure locate_element_should_resolve_container_path()
    %set_variable_value("LOCATOR_SYSTEMS_ROOT", "../Elements/Systems")
    !$actual = $locate_element("container", "Payments", "ERP")
    !assert $actual == "../Elements/Systems/ERP/Containers/Payments.container.puml"
!endprocedure
''----------------------------------------------------------------------------------------------------------------------
!procedure locate_element_should_resolve_boundary_inside_system()
    %set_variable_value("LOCATOR_SYSTEMS_ROOT", "../Elements/Systems")
    !$actual = $locate_element("boundary", "Core", "ERP")
    !assert $actual == "../Elements/Systems/ERP/Boundaries/Core.boundary.puml"
!endprocedure
''----------------------------------------------------------------------------------------------------------------------
!procedure locate_relation_should_resolve_path_inside_container()
    %set_variable_value("LOCATOR_SYSTEMS_ROOT", "../Elements/Systems")
    !$actual = $locate_relation("API-DB", "ERP/Employees")
    !assert $actual == "../Elements/Systems/ERP/Containers/Employees/Relations/API-DB.relation.puml"
!endprocedure
''----------------------------------------------------------------------------------------------------------------------
!procedure locate_element_should_resolve_component_path()
    %set_variable_value("LOCATOR_SYSTEMS_ROOT", "../Elements/Systems")
    !$actual = $locate_element("component", "API", "ERP/Employees")
    !assert $actual == "../Elements/Systems/ERP/Containers/Employees/Components/API.component.puml"
!endprocedure
''----------------------------------------------------------------------------------------------------------------------
!procedure locator_var_name_should_map_person_to_persons()
    !$actual = $__locator_var_name("person")
    !assert $actual == "LOCATOR_PERSONS_ROOT"
!endprocedure
''----------------------------------------------------------------------------------------------------------------------
!procedure locator_var_name_should_map_boundary_to_boundaries()
    !$actual = $__locator_var_name("boundary")
    !assert $actual == "LOCATOR_BOUNDARIES_ROOT"
!endprocedure
''----------------------------------------------------------------------------------------------------------------------
!procedure plural_should_return_pascalcase_plural()
    !$actual = $__plural("container")
    !assert $actual == "Containers"
!endprocedure
''----------------------------------------------------------------------------------------------------------------------
!procedure plural_should_return_boundaries_for_boundary()
    !$actual = $__plural("boundary")
    !assert $actual == "Boundaries"
!endprocedure
''----------------------------------------------------------------------------------------------------------------------
!procedure locator_root_should_return_env_value()
    %set_variable_value("LOCATOR_PERSONS_ROOT", "../Persons")
    !$actual = $locator_root("person")
    !assert $actual == "../Persons"
!endprocedure
''----------------------------------------------------------------------------------------------------------------------
!procedure locator_root_should_return_empty_when_unset()
    !$actual = $locator_root("nonexistent_kind")
    !assert $actual == ""
!endprocedure
''----------------------------------------------------------------------------------------------------------------------
'' Tests RUN!
''----------------------------------------------------------------------------------------------------------------------
locate_relation_should_resolve_top_level_path()
locate_element_should_resolve_person_path()
locate_element_should_resolve_system_path()
locate_element_should_resolve_boundary_path()
locate_relation_should_resolve_path_inside_system()
locate_element_should_resolve_container_path()
locate_element_should_resolve_boundary_inside_system()
locate_relation_should_resolve_path_inside_container()
locate_element_should_resolve_component_path()
locator_var_name_should_map_person_to_persons()
locator_var_name_should_map_boundary_to_boundaries()
plural_should_return_pascalcase_plural()
plural_should_return_boundaries_for_boundary()
locator_root_should_return_env_value()
locator_root_should_return_empty_when_unset()
''----------------------------------------------------------------------------------------------------------------------
caption OK
@enduml
