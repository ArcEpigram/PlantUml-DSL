@startuml
!include ../src/Locator.puml
''----------------------------------------------------------------------------------------------------------------------
'' Tests for Locator module
''
'' Тактика: тесты добавляются по одному, от простого к сложному.
'' Каждый тест проходит assert через утилиту check(), которая использует
'' $contain_in_list() — проверенный паттерн из Utils.Tests.puml.
''----------------------------------------------------------------------------------------------------------------------
''----------------------------------------------------------------------------------------------------------------------
'' Утилита сравнения: проверяет, что $actual соответствует $expected (regex pattern)
'' Использует %size(%splitstr_regex(...)) == 1 — проверенный паттерн из Utils.Tests.puml.
'' Перед сравнением оба значения оборачиваются в regex-якоря ^...$.
''----------------------------------------------------------------------------------------------------------------------
!function $assert_eq($actual, $expected)
    !$pattern = $format("/^%1$/gm", $expected)
    !return %size(%splitstr_regex($actual, $pattern)) == 1
!endfunction
''----------------------------------------------------------------------------------------------------------------------
'' Утилита-fail: печатает assertion failed, но НЕ прерывает -checkonly
'' Используем title + $trace вместо $fail, чтобы не помечать диаграмму как broken
''----------------------------------------------------------------------------------------------------------------------
!procedure check($actual, $expected)
    !if $assert_eq($actual, $expected) != %true()
        title "ASSERT FAILED: expected '$expected' but got '$actual'"
        !assert %false() : $format('expected "%1" but got "%2"', $expected, $actual)
    !endif
!endprocedure
''----------------------------------------------------------------------------------------------------------------------
'' Тест 1 (самый простой): Relation на верхнем уровне
'' args: $element_type=relation, $alias=Manager-ERP, $scope=""
''----------------------------------------------------------------------------------------------------------------------
!procedure t1_locate_relation_top_level()
    '' Arrange
    %set_variable_value("LOCATOR_RELATIONS_ROOT", "../Elements/Relations")

    '' Act
    !$actual = $locate_relation("Manager-ERP")

    '' Assert
    check($actual, "../Elements/Relations/Manager-ERP.relation.puml")
!endprocedure
