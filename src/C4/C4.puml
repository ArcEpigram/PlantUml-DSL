@startuml
!include <C4/C4_Context>
!include <C4/C4_Container>
!include ../Utils.puml
!include ../Common.puml
!include ../Rendering.puml
!include ../Locator.puml
''----------------------------------------------------------------------------------------------------------------------
'' Общий модуль C4: фабрики дескрипторов/декораторов, Boundary, Relation, общие хелперы включения и рендеринга.
'' Подключается модулями Context и Container.
'' Зависимости: <C4/C4_Context>, <C4/C4_Container>, Utils.puml, Common.puml, Rendering.puml, Locator.puml
''----------------------------------------------------------------------------------------------------------------------
$register_rendering_proc("Relation", $proc="$render_relation")
''----------------------------------------------------------------------------------------------------------------------
'' Включает зарегистрированные Boundary в текущую диаграмму.
'' Создаёт/обновляет группу в BOUNDARY_GROUPS с label и типом из дескриптора.
'' 1-arg форма: пути через Locator (нужна переменная окружения LOCATOR_BOUNDARIES_ROOT).
'' args: $aliases - алиасы границ (разделённые пробелом)
'' example: Boundaries(Enterprise CoreSystem)
!unquoted procedure Boundaries($aliases)
    $include_boundaries("", $aliases)
!endprocedure
''----------------------------------------------------------------------------------------------------------------------
'' 2-arg форма Boundaries: явный путь к каталогу с объявлениями границ.
'' args: $source - путь к каталогу с объявлениями границ
''       $aliases - алиасы границ (разделённые пробелом)
'' example: Boundaries("TestBoundaries", "Enterprise CoreSystem")
!unquoted procedure Boundaries($source, $aliases)
    $include_boundaries($source, $aliases)
!endprocedure
''----------------------------------------------------------------------------------------------------------------------
'' Внутренняя реализация включения Boundaries в диаграмму.
'' Если $source пустой — пути через Locator (LOCATOR_BOUNDARIES_ROOT).
!unquoted procedure $include_boundaries($source, $aliases, $scope="")
    !foreach $alias in %splitstr($aliases, " ")
        !if $source != ""
            !$boundary_file = $format("%1/%2.boundary.puml", $source, $alias)
            !include $boundary_file
        !else
            !$boundary_file = $locate_element("boundary", $alias, $scope)
            !if $boundary_file != ""
                !include $boundary_file
            !endif
        !endif

        '' Обновляем группу: label и тип из дескриптора, aliases пока пустые
        !$serialized_desc = $get_descriptor($alias)
        !$desc = $str2json($serialized_desc, $without_quotes = %true())
        !$b_type = $default($desc.boundary_type)
        !$b_label = $desc.label
        $add_boundary_group($alias, $b_label, $b_type, "", "", "", "")
    !endfor
!endprocedure
''----------------------------------------------------------------------------------------------------------------------
'' Создаёт ad-hoc группировку элементов в границу на диаграмме.
'' Две формы:
'' - Group("Label", "aliases") — generic Boundary с label и алиасами
'' - Group("b_alias", "Label", "aliases") — ссылка на зарегистрированный Boundary
'' args: $arg1 - label (2-arg форма) или алиас зарегистрированного Boundary (3-arg форма)
''       $arg2 - алиасы элементов (2-arg) или label (3-arg)
''       $arg3 - алиасы элементов для 3-arg формы (опционально)
'' example: Group("Группа важных систем", "ERP SSO")
'' example: Group("Enterprise", "Корп. окружение", "ERP SSO")
!unquoted procedure Group($arg1, $arg2, $arg3="")
    !if $arg3 != ""
        '' 3-arg: ссылка на зарегистрированный Boundary
        !$b_alias = $arg1
        !$label = $arg2
        !$aliases = $arg3
        !if $has_descriptor($b_alias)
            !$serialized_desc = $get_descriptor($b_alias)
            !$desc = $str2json($serialized_desc, $without_quotes = %true())
            !$b_type = $default($desc.boundary_type)
        !else
            !$b_type = ""
        !endif
        $add_boundary_group($b_alias, $label, $b_type, $aliases, "", "", "")
    !else
        '' 2-arg: generic Boundary. Генерируем безопасный b_alias с префиксом grp_,
        '' чтобы избежать пробелов и конфликтов с алиасами элементов.
        !$parts = %splitstr($arg2, " ")
        !$b_alias = $format("grp_%1", $parts[0])
        $add_boundary_group($b_alias, $arg1, "", $arg2, "", "", "")
    !endif
!endprocedure
''----------------------------------------------------------------------------------------------------------------------
'' Создаёт декоратор элемента со значениями по умолчанию.
'' args: $is_extern — %true() для внешнего элемента, %false() для внутреннего
'' returns: JSON-объект {is_extern, show_desc, sprite, styles}
!function $default_c4_element_decorator($is_extern)
    '' TODO: добавить остальные атрибуты опций рендеринга
    !$decorator = {}
    !$decorator = $json_add($decorator, "is_extern", $is_extern)
    !$decorator = $json_add($decorator, "show_desc", %true())
    !$decorator = $json_add($decorator, "sprite", "")
    !$decorator = $json_add($decorator, "styles", [])
    !return $decorator
!endfunction
''----------------------------------------------------------------------------------------------------------------------
'' Создаёт дескриптор C4-элемента.
'' args: $element_type - тип элемента ("Person", "System", "Container", "Component")
''       $label - отображаемое имя
''       $desc - описание (опционально)
''       $sprite - спрайт (опционально)
''       $tags - теги (опционально)
''       $link - ссылка (опционально)
''       $type - стереотип (опционально)
''       $reason - обоснование присутствия элемента в архитектуре (опционально)
''       $reason_source - источник обоснования: требование, документ, глоссарий (опционально)
'' returns: JSON-объект {type, label, desc, sprite, tags, link, element_type, reason, reason_source}
!function $default_c4_element_descriptor( \
    $element_type, $label, $desc="", $sprite="", $tags="", $link="", \
    $type="", $reason="", $reason_source="", $boundary="", $techn="", $baseShape="" \
)
    '' TODO: добавить остальные атрибуты C4-элемента
    !$descriptor = {}
    !$descriptor = $json_add($descriptor, "type", $element_type)
    !$descriptor = $json_add($descriptor, "label", $label)
    !$descriptor = $json_add($descriptor, "desc", $desc)
    !$descriptor = $json_add($descriptor, "sprite", $sprite)
    !$descriptor = $json_add($descriptor, "tags", $tags)
    !$descriptor = $json_add($descriptor, "link", $link)
    !$descriptor = $json_add($descriptor, "element_type", $type)
    !$descriptor = $json_add($descriptor, "reason", $reason)
    !$descriptor = $json_add($descriptor, "reason_source", $reason_source)
    !$descriptor = $json_add($descriptor, "boundary", $boundary)
    !$descriptor = $json_add($descriptor, "techn", $techn)
    !$descriptor = $json_add($descriptor, "baseShape", $baseShape)
    !return $descriptor
!endfunction
''----------------------------------------------------------------------------------------------------------------------
'' Привязывает элемент к его Boundary группе на основе поля $boundary в дескрипторе.
'' Если дескриптор Boundary существует — использует его label и boundary_type.
'' Если нет — создаёт группу с алиасом в качестве label и пустым типом.
'' args: $alias - алиас элемента
!procedure $__link_element_to_boundary($alias)
    !if $has_descriptor($alias)
        !$serialized_desc = $get_descriptor($alias)
        !$desc = $str2json($serialized_desc, $without_quotes = %true())
        !$boundary_alias = $default($desc.boundary)
        !if $boundary_alias != ""
            !if $has_descriptor($boundary_alias)
                !$b_serialized = $get_descriptor($boundary_alias)
                !$b_desc = $str2json($b_serialized, $without_quotes = %true())
                !$b_type = $default($b_desc.boundary_type)
                !$b_label = $b_desc.label
                $add_boundary_group($boundary_alias, $b_label, $b_type, $alias, "", "", "")
            !else
                '' Boundary ещё не зарегистрирован — используем alias как label
                $add_boundary_group($boundary_alias, $boundary_alias, "", $alias, "", "", "")
            !endif
        !endif
    !endif
!endprocedure
''----------------------------------------------------------------------------------------------------------------------
'' Внутренняя реализация включения элементов в диаграмму.
'' Если $source пустой — пути вычисляются через Locator на основе LOCATOR_*_ROOT переменных окружения.
'' Если переменная LOCATOR_*_ROOT не задана, путь будет пустым и !include будет пропущен
'' (но алиас всё равно попадёт в очередь рендеринга).
!unquoted procedure $include_elements($element_type, $source, $aliases, $is_extern, $scope="")
    !foreach $alias in %splitstr($aliases, " ")
        !if $source != ""
            !$element_file = $format("%1/%2.%3.puml", $source, $alias, $element_type)
            !include $element_file
        !else
            !$element_file = $locate_element($element_type, $alias, $scope)
            !if $element_file != ""
                !include $element_file
            !endif
        !endif

        !$decorator = $default_c4_element_decorator($is_extern)
        $register_decorator($alias, $decorator)

        $add_to_rendering_queue($alias)

        $__link_element_to_boundary($alias)
    !endfor
!endprocedure
''----------------------------------------------------------------------------------------------------------------------
'' Вычисляет общие поля параметров рендеринга C4-элемента: label, desc, sprite, tags, link, is_extern.
'' Чистая функция: не имеет побочных эффектов.
'' args: $descriptor - JSON-объект {type, label, desc, sprite, tags, link, element_type}
''       $decorator - JSON-объект {is_extern, show_desc, sprite, styles}
'' returns: JSON-объект {label, desc, sprite, tags, link, is_extern}
!function $__resolve_common_render_params($descriptor, $decorator)
    !$params = {}

    !$params = $json_add($params, "label", $descriptor.label)

    !$params = $json_add($params, "desc", $value_or_default($decorator.show_desc == %true(), $descriptor.desc))

    !$decor_sprite = $default($decorator.sprite)
    !if $decor_sprite != ""
        !$params = $json_add($params, "sprite", $decor_sprite)
    !else
        !$params = $json_add($params, "sprite", $default($descriptor.sprite))
    !endif

    !$params = $json_add($params, "tags", $combine_tags($default($descriptor.tags), $array2str($decorator.styles, "+")))

    !$params = $json_add($params, "link", $default($descriptor.link))

    !$params = $json_add($params, "is_extern", $decorator.is_extern)

    !return $params
!endfunction
''----------------------------------------------------------------------------------------------------------------------
'' Создаёт дескриптор связи C4 Relation.
'' args: $from - алиас исходного элемента
''       $to - алиас целевого элемента
''       $label - отображаемая метка связи
''       $techn - технология (опционально)
''       $desc - описание (опционально)
''       $tags - теги (опционально)
''       $reason - обоснование присутствия связи в архитектуре (опционально)
''       $reason_source - источник обоснования: требование, документ, глоссарий (опционально)
'' returns: JSON-объект {type, from, to, label, techn, desc, tags, reason, reason_source}
!function $default_relation_descriptor($from, $to, $label, $techn="", $desc="", $tags="", $reason="", $reason_source="")
    !$descriptor = {}
    !$descriptor = $json_add($descriptor, "type", "Relation")
    !$descriptor = $json_add($descriptor, "from", $from)
    !$descriptor = $json_add($descriptor, "to", $to)
    !$descriptor = $json_add($descriptor, "label", $label)
    !$descriptor = $json_add($descriptor, "techn", $techn)
    !$descriptor = $json_add($descriptor, "desc", $desc)
    !$descriptor = $json_add($descriptor, "tags", $tags)
    !$descriptor = $json_add($descriptor, "reason", $reason)
    !$descriptor = $json_add($descriptor, "reason_source", $reason_source)
    !return $descriptor
!endfunction
''----------------------------------------------------------------------------------------------------------------------
'' Создаёт декоратор связи со значениями по умолчанию.
'' returns: JSON-объект {show_label, show_techn, show_desc, link, sprite, styles, lay_direction}
!function $default_relation_decorator()
    !$decorator = {}
    !$decorator = $json_add($decorator, "show_label", %true())
    !$decorator = $json_add($decorator, "show_techn", %true())
    !$decorator = $json_add($decorator, "show_desc", %true())
    !$decorator = $json_add($decorator, "link", "")
    !$decorator = $json_add($decorator, "sprite", "")
    !$decorator = $json_add($decorator, "styles", [])
    !$decorator = $json_add($decorator, "lay_direction", "")
    !return $decorator
!endfunction
''----------------------------------------------------------------------------------------------------------------------
'' Формирует alias связи из from/to и опционального суффикса.
'' Без суффикса: "ERP-DB". С суффиксом: "ERP-DB-slow".
'' Чистая функция: не имеет побочных эффектов.
'' args: $from - алиас исходного элемента
''       $to - алиас целевого элемента
''       $suffix - суффикс для дизамбигуации при нескольких связях между парой (опционально)
'' example: !$alias = $build_relation_alias("ERP", "DB")           '' "ERP-DB"
'' example: !$alias = $build_relation_alias("ERP", "DB", "slow")   '' "ERP-DB-slow"
!function $build_relation_alias($from, $to, $suffix="")
    !if $default($suffix) == ""
        !return $format("%1-%2", $from, $to)
    !else
        !return $format("%1-%2-%3", $from, $to, $suffix)
    !endif
!endfunction
''----------------------------------------------------------------------------------------------------------------------
'' Регистрирует связь между элементами.
'' Создаёт дескриптор (атрибуты) и сохраняет его в глобальный реестр под автоматически сгенерированным alias.
'' Alias формируется как "from-to" (или "from-to-suffix" при заданном $suffix).
'' Декоратор создаётся при включении в диаграмму командой Relations().
'' args: $from - алиас исходного элемента
''       $to - алиас целевого элемента
''       $label - отображаемая метка связи
''       $suffix - суффикс alias для дизамбигуации нескольких связей между парой (опционально)
''       $techn - технология (опционально)
''       $desc - описание (опционально)
''       $tags - теги (опционально)
''       $reason - обоснование присутствия связи в архитектуре (опционально)
''       $reason_source - источник обоснования: требование, документ, глоссарий (опционально)
'' example: $Relation("ERP", "DB", "Читает и пишет", "", "JDBC", "Основной канал данных")
'' example: $Relation("ERP", "DB", "Медленный путь", "slow")
!unquoted procedure $Relation($from, $to, $label, $suffix="", $techn="", $desc="", $tags="", $reason="", $reason_source="")
    !$alias = $build_relation_alias($from, $to, $suffix)
    !$descriptor = $default_relation_descriptor($from, $to, $label, $techn, $desc, $tags, $reason, $reason_source)
    $register_descriptor($alias, $json2str($descriptor, %true()))
!endprocedure
''----------------------------------------------------------------------------------------------------------------------
'' Внутренняя реализация включения связей в диаграмму.
'' Если $source пустой — пути через Locator (LOCATOR_RELATIONS_ROOT или LOCATOR_SYSTEMS_ROOT).
!unquoted procedure $include_relations($source, $aliases, $scope="")
    !foreach $alias in %splitstr($aliases, " ")
        !if $source != ""
            !$relation_file = $format("%1/%2.relation.puml", $source, $alias)
            !include $relation_file
        !else
            !$relation_file = $locate_relation($alias, $scope)
            !if $relation_file != ""
                !include $relation_file
            !endif
        !endif

        !$decorator = $default_relation_decorator()
        $register_decorator($alias, $decorator)

        $add_to_rendering_queue($alias)
    !endfor
!endprocedure
''----------------------------------------------------------------------------------------------------------------------
'' Включает зарегистрированные связи в текущую диаграмму.
'' 1-arg форма: пути через Locator (нужна переменная окружения LOCATOR_RELATIONS_ROOT).
'' args: $aliases - перечисление алиасов связей (разделенные пробелом)
'' example: Relations(User-ERP ERP-1C)
!unquoted procedure Relations($aliases)
    $include_relations("", $aliases)
!endprocedure
''----------------------------------------------------------------------------------------------------------------------
'' 2-arg форма Relations: явный путь к каталогу с объявлениями связей.
'' args: $source - путь к каталогу с объявлениями связей
''       $aliases - перечисление алиасов связей (разделенные пробелом)
'' example: Relations("Relations", User-ERP ERP-1C)
!unquoted procedure Relations($source, $aliases)
    $include_relations($source, $aliases)
!endprocedure
''----------------------------------------------------------------------------------------------------------------------
'' Внутренняя реализация задания направления связи для списка связей.
'' Изменяет декоратор каждой связи, добавляя lay_direction = $direction.
'' args: $aliases - перечисление алиасов связей (разделенные пробелом)
''       $direction - направление связи: "Down", "Up", "Left", "Right"
!procedure $align($aliases, $direction)
    !foreach $alias in %splitstr($aliases, " ")
        $update_decorator($alias, "lay_direction", $direction)
    !endfor
!endprocedure
''----------------------------------------------------------------------------------------------------------------------
'' Устанавливает направление связи "вниз" для заданных связей.
'' args: $aliases - перечисление алиасов связей (разделенные пробелом)
'' example: Align_Down("User-ERP ERP-1C")
!unquoted procedure Align_Down($aliases)
    $align($aliases, "Down")
!endprocedure
''----------------------------------------------------------------------------------------------------------------------
'' Устанавливает направление связи "вверх" для заданных связей.
'' args: $aliases - перечисление алиасов связей (разделенные пробелом)
'' example: Align_Up("User-ERP")
!unquoted procedure Align_Up($aliases)
    $align($aliases, "Up")
!endprocedure
''----------------------------------------------------------------------------------------------------------------------
'' Устанавливает направление связи "влево" для заданных связей.
'' args: $aliases - перечисление алиасов связей (разделенные пробелом)
'' example: Align_Left("ERP-1C")
!unquoted procedure Align_Left($aliases)
    $align($aliases, "Left")
!endprocedure
''----------------------------------------------------------------------------------------------------------------------
'' Устанавливает направление связи "вправо" для заданных связей.
'' args: $aliases - перечисление алиасов связей (разделенные пробелом)
'' example: Align_Right("ERP-SSO")
!unquoted procedure Align_Right($aliases)
    $align($aliases, "Right")
!endprocedure
''----------------------------------------------------------------------------------------------------------------------
'' Вычисляет параметры рендеринга для связи Relation на основе дескриптора и декоратора.
'' Чистая функция: не имеет побочных эффектов.
'' args: $descriptor - JSON-объект {type, from, to, label, techn, desc, tags}
''       $decorator - JSON-объект {show_label, show_techn, show_desc, link, sprite, styles, lay_direction}
'' returns: JSON-объект {from, to, label, techn, desc, sprite, link, tags, lay_direction}
!function $resolve_relation_render_params($descriptor, $decorator)
    !$params = {}

    !$params = $json_add($params, "from", $descriptor.from)
    !$params = $json_add($params, "to", $descriptor.to)

    !$params = $json_add($params, "label", $value_or_default($decorator.show_label == %true(), $descriptor.label))
    !$params = $json_add($params, "techn", $value_or_default($decorator.show_techn == %true(), $descriptor.techn))
    !$params = $json_add($params, "desc", $value_or_default($decorator.show_desc == %true(), $descriptor.desc))

    !$params = $json_add($params, "sprite", $decorator.sprite)
    !$params = $json_add($params, "link", $decorator.link)

    !$params = $json_add($params, "tags", $combine_tags($default($descriptor.tags), $array2str($decorator.styles, "+")))

    !$params = $json_add($params, "lay_direction", $default($decorator.lay_direction))

    !return $params
!endfunction
''----------------------------------------------------------------------------------------------------------------------
'' Рендерит связь в нотации C4 Context.
'' Десериализует дескриптор, вычисляет параметры с учётом декоратора,
'' затем вызывает стандартную функцию Rel(), Rel_D(), Rel_U(), Rel_L() или Rel_R()
'' в зависимости от направления связи (lay_direction).
'' args: $alias - алиас связи
''       $serialized_descriptor - дескриптор связи {type, from, to, label, techn, desc, tags}
''       $decorator - декоратор связи {show_label, show_techn, show_desc, link, sprite, styles, lay_direction}
!procedure $render_relation($alias, $serialized_descriptor, $decorator)
    !$descriptor = $str2json($serialized_descriptor, $without_quotes = %true())
    !$params = $resolve_relation_render_params($descriptor, $decorator)

    !$native_proc = $resolve_relation_native_proc($default($params.lay_direction))

    %invoke_procedure(\
        $native_proc, \
        $params.from, \
        $params.to, \
        $default($params.label), \
        $default($params.techn), \
        $default($params.desc), \
        $default($params.sprite), \
        $default($params.tags), \
        $default($params.link) \
    )
!endprocedure
''----------------------------------------------------------------------------------------------------------------------
'' Преобразует тип Boundary в имя нативной процедуры C4-PlantUML.
'' Чистая функция: не имеет побочных эффектов.
'' args: $boundary_type - тип границы: "Enterprise", "System", "Container" или "" (generic)
'' returns: имя нативной процедуры: "Enterprise_Boundary", "System_Boundary", "Container_Boundary" или "Boundary"
'' example: !$proc = $resolve_boundary_native_proc("Enterprise")
!function $resolve_boundary_native_proc($boundary_type)
    !if $boundary_type == "Enterprise"
        !return "Enterprise_Boundary"
    !elseif $boundary_type == "System"
        !return "System_Boundary"
    !elseif $boundary_type == "Container"
        !return "Container_Boundary"
    !else
        !return "Boundary"
    !endif
!endfunction
''----------------------------------------------------------------------------------------------------------------------
'' Преобразует направление связи в имя нативной процедуры C4-PlantUML.
'' Чистая функция: не имеет побочных эффектов.
'' args: $lay_direction - направление связи: "Down", "Up", "Left", "Right" или "" (default)
'' returns: имя нативной процедуры: "Rel_D", "Rel_U", "Rel_L", "Rel_R" или "Rel"
'' example: !$proc = $resolve_relation_native_proc("Down")
!function $resolve_relation_native_proc($lay_direction)
    !if $lay_direction == "Down"
        !return "Rel_D"
    !elseif $lay_direction == "Up"
        !return "Rel_U"
    !elseif $lay_direction == "Left"
        !return "Rel_L"
    !elseif $lay_direction == "Right"
        !return "Rel_R"
    !else
        !return "Rel"
    !endif
!endfunction
''----------------------------------------------------------------------------------------------------------------------
'' Создаёт дескриптор для элемента типа Boundary.
'' Чистая функция: не имеет побочных эффектов.
'' args: $label - отображаемое имя границы
''       $desc - описание (опционально)
''       $tags - теги (опционально)
''       $link - ссылка (опционально)
''       $boundary_type - тип границы: "Enterprise", "System", "Container" или "" (опционально)
'' returns: JSON-объект {type, label, desc, tags, link, boundary_type}
!function $default_boundary_descriptor($label, $desc="", $tags="", $link="", $boundary_type="")
    !$descriptor = {}
    !$descriptor = $json_add($descriptor, "type", "Boundary")
    !$descriptor = $json_add($descriptor, "label", $label)
    !$descriptor = $json_add($descriptor, "desc", $desc)
    !$descriptor = $json_add($descriptor, "tags", $tags)
    !$descriptor = $json_add($descriptor, "link", $link)
    !$descriptor = $json_add($descriptor, "boundary_type", $boundary_type)
    !return $descriptor
!endfunction
''----------------------------------------------------------------------------------------------------------------------
'' Регистрирует архитектурную границу Boundary.
'' args: $alias - уникальный алиас границы
''       $label - отображаемое имя
''       $desc - описание (опционально)
''       $tags - теги (опционально)
''       $link - ссылка (опционально)
''       $type - тип границы: "Enterprise", "System", "Container" или "" (опционально)
'' example: $Boundary("Enterprise", "Корп. окружение", "Корпоративная сеть", "", "", "Enterprise")
!unquoted procedure $Boundary($alias, $label, $desc="", $tags="", $link="", $type="")
    !$descriptor = $default_boundary_descriptor($label, $desc, $tags, $link, $type)
    $register_descriptor($alias, $json2str($descriptor, %true()))
!endprocedure
''----------------------------------------------------------------------------------------------------------------------
'' Закрывает блок границы.
!procedure $emit_boundary_close()
    }
!endprocedure
''----------------------------------------------------------------------------------------------------------------------
'' Открывает блок границы по имени нативной процедуры C4-PlantUML.
'' args: $native_proc - имя нативной процедуры ("Enterprise_Boundary", "System_Boundary", "Container_Boundary" или "Boundary")
''       $alias - алиас границы
''       $label - отображаемое имя
''       $sprite - спрайт (опционально)
''       $tags - теги (опционально)
''       $link - ссылка (опционально)
!procedure $emit_boundary_open($native_proc, $alias, $label, $sprite, $tags, $link)
    %invoke_procedure($native_proc, $default($alias), $default($label), $default($sprite), $default($tags), $default($link)) {
!endprocedure
''----------------------------------------------------------------------------------------------------------------------
@enduml
