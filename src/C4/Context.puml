@startuml
!include <C4/C4_Context>
!include ../Utils.puml
!include ../Common.puml
!include ../Rendering.puml
''----------------------------------------------------------------------------------------------------------------------
'' Модуль C4 System Context Diagram.
'' Регистрация элементов C4 Person и их рендеринг в нотации C4 Context.
'' Зависимости: <C4/C4_Context>, Utils.puml, Common.puml, Rendering.puml
''----------------------------------------------------------------------------------------------------------------------
'' Регистрирует архитектурный элемент типа Person.
'' Создаёт дескриптор (атрибуты) и декоратор (опции отображения по умолчанию),
'' сохраняет оба в глобальный реестр.
'' args: $alias - уникальный алиас элемента
''       $label - отображаемое имя элемента
''       $desc - описание элемента (опционально)
''       $tags - теги элемента (опционально)
'' example: $Person("User", "Пользователь", "Описание пользователя")
!unquoted procedure $Person($alias, $label, $desc="", $tags="")
    '' 1. Guard: !assert $alias != ""; !assert $label != ""

    '' 2. Создать дескриптор:
    !$descriptor = {}
    !$descriptor = $json_add($descriptor, "type", "Person")
    !$descriptor = $json_add($descriptor, "label", $label)
    !$descriptor = $json_add($descriptor, "desc", $desc)
    !$descriptor = $json_add($descriptor, "tags", [])

    '' 3. Зарегистрировать дескриптор в очереди рендеринга.
    $register_descriptor($alias, $json2str($descriptor, %true()))
!endprocedure
''----------------------------------------------------------------------------------------------------------------------
'' Включает зарегистрированные элементы Person в текущую диаграмму.
'' Добавляет алиасы в очередь рендеринга.
'' args: $source - путь к каталогу к объявлениям элементов.
''       $aliases - перечисление имен элементов (разделенные пробелом).
'' example: Persons("Elements", User)
!unquoted procedure Persons($source, $aliases)
    !if $source != ""
        !foreach $alias in %splitstr($aliases, " ")
            '' 1. Включение элемента в диаграмму.
            '' Процедура регистрации $Person(...) будет вызвана автоматически.
            !$element_file = $format("%1/%2.person.puml", $source, $alias)
            !include $element_file

            '' 2. Создать декоратор элемента по умолчанию
            '' TODO: Вынести в отдельную функцию
            !$decorator = {}
            !$decorator = $json_add($decorator, "is_extern", %false())
            !$decorator = $json_add($decorator, "show_desc", %true())
            !$decorator = $json_add($decorator, "styles", [])
            $register_decorator($alias, $decorator)

            '' 3. Добавить алиас элемента в очередь рендеринга.
            $add_to_rendering_queue($alias)
        !endfor
    !endif
!endprocedure
''----------------------------------------------------------------------------------------------------------------------
!unquoted procedure Persons_Ext($source, $aliases)
    !if $source != ""
        !foreach $alias in %splitstr($aliases, " ")
            '' 1. Включение элемента в диаграмму.
            '' Процедура регистрации $Person(...) будет вызвана автоматически.
            !$element_file = $format("%1/%2.person.puml", $source, $alias)
            !include $element_file

            '' 2. Создать декоратор элемента по умолчанию
            '' TODO: Вынести в отдельную функцию
            !$decorator = {}
            !$decorator = $json_add($decorator, "is_extern", %true())
            !$decorator = $json_add($decorator, "show_desc", %true())
            !$decorator = $json_add($decorator, "styles", [])
            $register_decorator($alias, $decorator)

            '' 3. Добавить алиас элемента в очередь рендеринга.
            $add_to_rendering_queue($alias)
        !endfor
    !endif
!endprocedure
''----------------------------------------------------------------------------------------------------------------------
'' Рендерит элемент типа Person в нотации C4 Context.
'' Вызывает $resolve_person_render_params для вычисления параметров,
'' затем стандартную функцию Person() или Person_Ext() в зависимости от флага is_extern.
'' args: $alias - алиас элемента
''       $descriptor - дескриптор элемента {type, label, desc, tags}
''       $decorator - декоратор элемента {is_extern, show_desc, styles}
'' example: $render_person("User", $desc, $decor)
!procedure $render_person($alias, $descriptor, $decorator)
    '' 1. Вычислить параметры рендеринга: $params = $resolve_person_render_params($descriptor, $decorator)
    '' 2. Извлечь поля: $label = $params.label; $desc = $params.desc; $tags = $params.tags
    '' 3. Если $params.is_extern — Person_Ext($alias, $label, $desc, "", $tags)
    ''    Иначе — Person($alias, $label, $desc, "", $tags)
    !$unwrapped_descriptor = $str2json($descriptor, $without_quotes = %true())
    '!$unwrapped_decorator = $str2json($decorator, $without_quotes = %true())

    !if $decorator.show_desc == %true()
        !$desc = $unwrapped_descriptor.desc
    !else
        !$desc = ""
    !endif

    !if $decorator.is_extern == %true()
        Person_Ext($alias, $unwrapped_descriptor.label, $desc)
    !else
        Person($alias, $unwrapped_descriptor.label, $desc)
    !endif
!endprocedure
''----------------------------------------------------------------------------------------------------------------------
'' Вычисляет параметры рендеринга для элемента Person на основе дескриптора и декоратора.
'' Чистая функция: не имеет побочных эффектов, всегда возвращает одинаковый результат при одинаковых аргументах.
'' args: $descriptor - JSON-объект {type, label, desc, tags}
''       $decorator - JSON-объект {is_extern, show_desc, styles}
'' returns: JSON-объект {label, desc, is_extern, tags} — вычисленные параметры для нативного рендеринга
'' example: !$params = $resolve_person_render_params($desc, $decor)
!function $resolve_person_render_params($descriptor, $decorator)
    '' 1. Извлечь label из дескриптора: $label = $descriptor.label
    '' 2. Определить описание:
    ''    a. Если $decorator.show_desc — $desc = $descriptor.desc
    ''    b. Иначе — $desc = ""
    '' 3. Извлечь флаг внешнего элемента: $is_extern = $decorator.is_extern
    '' 4. Извлечь tags из дескриптора: $tags = $descriptor.tags
    '' 5. Собрать JSON-объект результата:
    ''    $result = {}
    ''    $result = $json_add($result, "label", $label)
    ''    $result = $json_add($result, "desc", $desc)
    ''    $result = $json_add($result, "is_extern", $is_extern)
    ''    $result = $json_add($result, "tags", $tags)
    '' 6. Вернуть $result
    !return {}
!endfunction
''----------------------------------------------------------------------------------------------------------------------
@enduml
