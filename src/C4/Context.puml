@startuml
!include C4.puml
''----------------------------------------------------------------------------------------------------------------------
'' Модуль C4 Context: элементы уровня системного контекста (Person, System).
'' Зависимости: C4.puml
''----------------------------------------------------------------------------------------------------------------------
$register_rendering_proc("Person", $proc="$render_person")
$register_rendering_proc("System", $proc="$render_system")
''----------------------------------------------------------------------------------------------------------------------
'' Регистрирует архитектурный элемент типа Person.
'' Создаёт дескриптор (атрибуты) и декоратор (опции отображения по умолчанию),
'' сохраняет оба в глобальный реестр.
'' Совместима со стандартной библиотекой C4-PlantUML: Person(alias, label, ?desc, ?sprite, ?tags, ?link, ?type)
'' args: $alias - уникальный алиас элемента
''       $label - отображаемое имя элемента
''       $desc - описание элемента (опционально)
''       $sprite - спрайт элемента (опционально)
''       $tags - теги элемента (опционально)
''       $link - ссылка элемента (опционально)
''       $type - стереотип элемента (опционально)
''       $reason - обоснование присутствия элемента в архитектуре (опционально)
''       $reason_source - источник обоснования: требование, документ, глоссарий (опционально)
'' example: $Person("User", "Пользователь", "Описание пользователя")
!unquoted procedure $Person($alias, $label, $desc="", $sprite="", $tags="", $link="", $type="", $reason="", $reason_source="", $boundary="")
    !$descriptor = $default_c4_element_descriptor("Person", $label, $desc, $sprite, $tags, $link, $type, $reason, $reason_source, $boundary)
    $register_descriptor($alias, $json2str($descriptor, %true()))
!endprocedure
''----------------------------------------------------------------------------------------------------------------------
'' Включает зарегистрированные элементы Person в текущую диаграмму.
'' 1-arg форма: пути через Locator (нужна переменная окружения LOCATOR_PERSONS_ROOT).
'' args: $aliases - перечисление имен элементов (разделенные пробелом)
'' example: Persons(User Admin)
!unquoted procedure Persons($aliases)
    $include_elements("person", "", $aliases, %false())
!endprocedure
''----------------------------------------------------------------------------------------------------------------------
'' 2-arg форма Persons: явный путь к каталогу с объявлениями элементов.
'' args: $source - путь к каталогу к объявлениям элементов
''       $aliases - перечисление имен элементов (разделенные пробелом)
'' example: Persons("Elements", User)
!unquoted procedure Persons($source, $aliases)
    $include_elements("person", $source, $aliases, %false())
!endprocedure
''----------------------------------------------------------------------------------------------------------------------
'' Включает зарегистрированные элементы Person как внешние (с серым фоном).
'' 1-arg форма: пути через Locator (нужна переменная окружения LOCATOR_PERSONS_ROOT).
'' args: $aliases - перечисление имен элементов (разделенные пробелом)
'' example: Persons_Ext(Admin)
!unquoted procedure Persons_Ext($aliases)
    $include_elements("person", "", $aliases, %true())
!endprocedure
''----------------------------------------------------------------------------------------------------------------------
'' 2-arg форма Persons_Ext: явный путь к каталогу с объявлениями элементов.
'' example: Persons_Ext("Elements", Admin)
!unquoted procedure Persons_Ext($source, $aliases)
    $include_elements("person", $source, $aliases, %true())
!endprocedure
''----------------------------------------------------------------------------------------------------------------------
'' Регистрирует архитектурный элемент типа System.
'' Совместима со стандартной библиотекой C4-PlantUML: System(alias, label, ?desc, ?sprite, ?tags, ?link, ?type)
'' args: $alias - уникальный алиас элемента
''       $label - отображаемое имя элемента
''       $desc - описание элемента (опционально)
''       $sprite - спрайт элемента (опционально)
''       $tags - теги элемента (опционально)
''       $link - ссылка элемента (опционально)
''       $type - стереотип элемента (опционально)
''       $reason - обоснование присутствия элемента в архитектуре (опционально)
''       $reason_source - источник обоснования: требование, документ, глоссарий (опционально)
'' example: $System("ERP", "ERP-система", "Основная учётная система")
!unquoted procedure $System($alias, $label, $desc="", $sprite="", $tags="", $link="", $type="", $reason="", $reason_source="", $boundary="")
    !$descriptor = $default_c4_element_descriptor("System", $label, $desc, $sprite, $tags, $link, $type, $reason, $reason_source, $boundary)
    $register_descriptor($alias, $json2str($descriptor, %true()))
!endprocedure
''----------------------------------------------------------------------------------------------------------------------
'' Включает зарегистрированные элементы System в текущую диаграмму.
'' 1-arg форма: пути через Locator (нужна переменная окружения LOCATOR_SYSTEMS_ROOT).
'' args: $aliases - перечисление имен элементов (разделенные пробелом)
'' example: Systems(ERP CMS)
!unquoted procedure Systems($aliases)
    $include_elements("system", "", $aliases, %false())
!endprocedure
''----------------------------------------------------------------------------------------------------------------------
'' 2-arg форма Systems: явный путь к каталогу с объявлениями элементов.
'' args: $source - путь к каталогу к объявлениям элементов
''       $aliases - перечисление имен элементов (разделенные пробелом)
'' example: Systems("Elements", ERP CMS)
!unquoted procedure Systems($source, $aliases)
    $include_elements("system", $source, $aliases, %false())
!endprocedure
''----------------------------------------------------------------------------------------------------------------------
'' Включает зарегистрированные элементы System как внешние (с серым фоном).
'' 1-arg форма: пути через Locator.
!unquoted procedure Systems_Ext($aliases)
    $include_elements("system", "", $aliases, %true())
!endprocedure
''----------------------------------------------------------------------------------------------------------------------
'' 2-arg форма Systems_Ext: явный путь.
'' example: Systems_Ext("Elements", ExternalService)
!unquoted procedure Systems_Ext($source, $aliases)
    $include_elements("system", $source, $aliases, %true())
!endprocedure
''----------------------------------------------------------------------------------------------------------------------
'' Рендерит элемент типа Person в нотации C4 Context.
'' Десериализует дескриптор, проверяет флаги show_desc и is_extern,
'' затем вызывает стандартную функцию Person() или Person_Ext().
'' args: $alias - алиас элемента
''       $descriptor - дескриптор элемента {type, label, desc, tags}
''       $decorator - декоратор элемента {is_extern, show_desc, styles}
'' example: $render_person("User", $desc, $decor)
!procedure $render_person($alias, $serialized_descriptor, $decorator)
    SHOW_PERSON_PORTRAIT()

    !$descriptor = $str2json($serialized_descriptor, $without_quotes = %true())
    !$params = $resolve_person_render_params($descriptor, $decorator)
    $render_c4_element($alias, $params)
!endprocedure
''----------------------------------------------------------------------------------------------------------------------
'' Рендерит элемент типа System в нотации C4 Context.
!procedure $render_system($alias, $serialized_descriptor, $decorator)
    !$descriptor = $str2json($serialized_descriptor, $without_quotes = %true())
    !$params = $resolve_system_render_params($descriptor, $decorator)
    $render_c4_element($alias, $params)
!endprocedure
''----------------------------------------------------------------------------------------------------------------------
'' Рендерит C4-элемент (Person, System) через нативную процедуру C4-PlantUML.
'' args: $alias - алиас элемента
''       $params - JSON с полями {label, desc, sprite, render_proc, tags, type, link, is_extern}
!procedure $render_c4_element($alias, $params)
    !if $params.is_extern == %true()
        !$render_proc_name = $format("%1_Ext", $params.render_proc)
    !else
       !$render_proc_name = $params.render_proc
    !endif

    %invoke_procedure(\
        $render_proc_name, \
        $alias, \
        $params.label, \
        $default($params.desc), \
        $default($params.sprite), \
        $default($params.tags), \
        $default($params.link), \
        $default($params.type) \
    )
!endprocedure
''----------------------------------------------------------------------------------------------------------------------
'' Вычисляет параметры рендеринга для C4-элемента на основе дескриптора и декоратора.
'' Чистая функция: не имеет побочных эффектов, всегда возвращает одинаковый результат при одинаковых аргументах.
'' args: $descriptor - JSON-объект {type, label, desc, sprite, tags, link, element_type, reason, reason_source}
''       $decorator - JSON-объект {is_extern, show_desc, sprite, styles}
''       $render_proc - имя нативной функции рендеринга ("Person", "System", "SystemQueue", "SystemDb")
'' returns: JSON-объект {label, desc, sprite, render_proc, tags, type, link, is_extern} — вычисленные параметры для нативного рендеринга
!function $resolve_c4_element_render_params($descriptor, $decorator, $render_proc)
    !$params = $__resolve_common_render_params($descriptor, $decorator)
    !$params = $json_add($params, "render_proc", $render_proc)
    !$params = $json_add($params, "type", $default($descriptor.element_type))
    !return $params
!endfunction
''----------------------------------------------------------------------------------------------------------------------
'' Вычисляет параметры рендеринга для элемента Person.
'' Обёртка над $resolve_c4_element_render_params.
!function $resolve_person_render_params($descriptor, $decorator)
    !return $resolve_c4_element_render_params($descriptor, $decorator, "Person")
!endfunction
''----------------------------------------------------------------------------------------------------------------------
'' Вычисляет параметры рендеринга для элемента System.
'' Маппинг element_type → нативная функция:
''   "Queue" → SystemQueue, "Db" → SystemDb, иначе → System
!function $resolve_system_render_params($descriptor, $decorator)
    !$etype = $default($descriptor.element_type)
    !$params = $__resolve_common_render_params($descriptor, $decorator)

    '' Маппинг element_type → render_proc
    !if $etype == "Queue"
        !$params = $json_add($params, "render_proc", "SystemQueue")
        !$params = $json_add($params, "type", "")
    !elseif $etype == "Db"
        !$params = $json_add($params, "render_proc", "SystemDb")
        !$params = $json_add($params, "type", "")
    !else
        !$params = $json_add($params, "render_proc", "System")
        !$params = $json_add($params, "type", $etype)
    !endif

    !return $params
!endfunction
''----------------------------------------------------------------------------------------------------------------------
@enduml
