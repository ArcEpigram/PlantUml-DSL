''----------------------------------------------------------------------------------------------------------------------
'' Диспетчер: выбирает нужный эмиттер границы по native_proc.
'' args: $native_proc - имя нативной процедуры
''       $alias - алиас границы
''       $label - отображаемое имя
''       $sprite - спрайт (опционально)
''       $tags - теги (опционально)
''       $link - ссылка (опционально)
!procedure $emit_boundary_open($native_proc, $alias, $label, $sprite, $tags, $link)
    !if $native_proc == "Enterprise_Boundary"
        $emit_enterprise_boundary_open($alias, $label, $sprite, $tags, $link)
    !elseif $native_proc == "System_Boundary"
        $emit_system_boundary_open($alias, $label, $sprite, $tags, $link)
    !elseif $native_proc == "Container_Boundary"
        $emit_container_boundary_open($alias, $label, $sprite, $tags, $link)
    !else
        $emit_generic_boundary_open($alias, $label, $sprite, $tags, $link)
    !endif
!endprocedure
