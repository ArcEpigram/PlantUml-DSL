@startuml
!include <C4/C4_Context>
!include ../Utils.puml
!include ../Common.puml
!include ../Rendering.puml
''----------------------------------------------------------------------------------------------------------------------
'' Регистрация процедур рендеринга элементов.
''----------------------------------------------------------------------------------------------------------------------
$register_rendering_proc("Person", $proc="$render_person")
$register_rendering_proc("Relation", $proc="$render_relation")
$register_rendering_proc("System", $proc="$render_system")
''----------------------------------------------------------------------------------------------------------------------
'' Регистрирует архитектурный элемент типа Person.
'' Создаёт дескриптор (атрибуты) и декоратор (опции отображения по умолчанию),
'' сохраняет оба в глобальный реестр.
'' Совместима со стандартной библиотекой C4-PlantUML: Person(alias, label, ?descr, ?sprite, ?tags, ?link, ?type)
'' args: $alias - уникальный алиас элемента
''       $label - отображаемое имя элемента
''       $descr - описание элемента (опционально)
''       $sprite - спрайт элемента (опционально)
''       $tags - теги элемента (опционально)
''       $link - ссылка элемента (опционально)
''       $type - стереотип элемента (опционально)
''       $reason - обоснование присутствия элемента в архитектуре (опционально)
''       $reason_source - источник обоснования: требование, документ, глоссарий (опционально)
'' example: $Person("User", "Пользователь", "Описание пользователя")
!unquoted procedure $Person($alias, $label, $descr="", $sprite="", $tags="", $link="", $type="", $reason="", $reason_source="")
    !$descriptor = $default_c4_element_descriptor("Person", $label, $descr, $sprite, $tags, $link, $type, $reason, $reason_source)
    $register_descriptor($alias, $json2str($descriptor, %true()))
!endprocedure
''----------------------------------------------------------------------------------------------------------------------
'' Включает зарегистрированные элементы Person в текущую диаграмму.
'' Добавляет алиасы в очередь рендеринга.
'' args: $source - путь к каталогу к объявлениям элементов.
''       $aliases - перечисление имен элементов (разделенные пробелом).
'' example: Persons("Elements", User)
!unquoted procedure Persons($source, $aliases)
    $include_elements("person", $source, $aliases, %false())
!endprocedure
''----------------------------------------------------------------------------------------------------------------------
'' Включает зарегистрированные элементы Person как внешние (с серым фоном) в текущую диаграмму.
'' args: $source - путь к каталогу к объявлениям элементов.
''       $aliases - перечисление имен элементов (разделенные пробелом).
'' example: Persons_Ext("Elements", Admin)
!unquoted procedure Persons_Ext($source, $aliases)
    $include_elements("person", $source, $aliases, %true())
!endprocedure
''----------------------------------------------------------------------------------------------------------------------
'' Регистрирует архитектурный элемент типа System.
'' Совместима со стандартной библиотекой C4-PlantUML: System(alias, label, ?descr, ?sprite, ?tags, ?link, ?type)
'' args: $alias - уникальный алиас элемента
''       $label - отображаемое имя элемента
''       $descr - описание элемента (опционально)
''       $sprite - спрайт элемента (опционально)
''       $tags - теги элемента (опционально)
''       $link - ссылка элемента (опционально)
''       $type - стереотип элемента (опционально)
''       $reason - обоснование присутствия элемента в архитектуре (опционально)
''       $reason_source - источник обоснования: требование, документ, глоссарий (опционально)
'' example: $System("ERP", "ERP-система", "Основная учётная система")
!unquoted procedure $System($alias, $label, $descr="", $sprite="", $tags="", $link="", $type="", $reason="", $reason_source="")
    !$descriptor = $default_c4_element_descriptor("System", $label, $descr, $sprite, $tags, $link, $type, $reason, $reason_source)
    $register_descriptor($alias, $json2str($descriptor, %true()))
!endprocedure
''----------------------------------------------------------------------------------------------------------------------
'' Создаёт декоратор элемента со значениями по умолчанию.
'' args: $is_extern — %true() для внешнего элемента, %false() для внутреннего
'' returns: JSON-объект {is_extern, show_desc, sprite, styles}
!function $default_c4_element_decorator($is_extern)
    '' TODO: добавить остальные атрибуты опций рендеринга
    !$decorator = {}
    !$decorator = $json_add($decorator, "is_extern", $is_extern)
    !$decorator = $json_add($decorator, "show_desc", %true())
    !$decorator = $json_add($decorator, "sprite", "")
    !$decorator = $json_add($decorator, "styles", [])
    !return $decorator
!endfunction
''----------------------------------------------------------------------------------------------------------------------
'' Создаёт дескриптор C4-элемента.
'' args: $element_type - тип элемента ("Person", "System", "Container", "Component")
''       $label - отображаемое имя
''       $desc - описание (опционально)
''       $sprite - спрайт (опционально)
''       $tags - теги (опционально)
''       $link - ссылка (опционально)
''       $type - стереотип (опционально)
''       $reason - обоснование присутствия элемента в архитектуре (опционально)
''       $reason_source - источник обоснования: требование, документ, глоссарий (опционально)
'' returns: JSON-объект {type, label, desc, sprite, tags, link, element_type, reason, reason_source}
!function $default_c4_element_descriptor($element_type, $label, $desc="", $sprite="", $tags="", $link="", $type="", $reason="", $reason_source="")
    '' TODO: добавить остальные атрибуты C4-элемента
    !$descriptor = {}
    !$descriptor = $json_add($descriptor, "type", $element_type)
    !$descriptor = $json_add($descriptor, "label", $label)
    !$descriptor = $json_add($descriptor, "desc", $desc)
    !$descriptor = $json_add($descriptor, "sprite", $sprite)
    !$descriptor = $json_add($descriptor, "tags", $tags)
    !$descriptor = $json_add($descriptor, "link", $link)
    !$descriptor = $json_add($descriptor, "element_type", $type)
    !$descriptor = $json_add($descriptor, "reason", $reason)
    !$descriptor = $json_add($descriptor, "reason_source", $reason_source)
    !return $descriptor
!endfunction
''----------------------------------------------------------------------------------------------------------------------
'' Внутренняя реализация включения элементов в диаграмму.
!unquoted procedure $include_elements($element_type, $source, $aliases, $is_extern)
    !if $source != ""
        !foreach $alias in %splitstr($aliases, " ")
            !$element_file = $format("%1/%2.%3.puml", $source, $alias, $element_type)
            !include $element_file

            !$decorator = $default_c4_element_decorator($is_extern)
            $register_decorator($alias, $decorator)

            $add_to_rendering_queue($alias)
        !endfor
    !endif
!endprocedure
''----------------------------------------------------------------------------------------------------------------------
'' Включает зарегистрированные элементы System в текущую диаграмму.
'' args: $source - путь к каталогу к объявлениям элементов.
''       $aliases - перечисление имен элементов (разделенные пробелом).
'' example: Systems("Elements", ERP CMS)
!unquoted procedure Systems($source, $aliases)
    $include_elements("system", $source, $aliases, %false())
!endprocedure
''----------------------------------------------------------------------------------------------------------------------
'' Включает зарегистрированные элементы System как внешние (с серым фоном) в текущую диаграмму.
'' args: $source - путь к каталогу к объявлениям элементов.
''       $aliases - перечисление имен элементов (разделенные пробелом).
'' example: Systems_Ext("Elements", ExternalService)
!unquoted procedure Systems_Ext($source, $aliases)
    $include_elements("system", $source, $aliases, %true())
!endprocedure
'' Рендерит элемент типа Person в нотации C4 Context.
'' Десериализует дескриптор, проверяет флаги show_desc и is_extern,
'' затем вызывает стандартную функцию Person() или Person_Ext().
'' args: $alias - алиас элемента
''       $descriptor - дескриптор элемента {type, label, desc, tags}
''       $decorator - декоратор элемента {is_extern, show_desc, styles}
'' example: $render_person("User", $desc, $decor)
!procedure $render_person($alias, $serialized_descriptor, $decorator)
    SHOW_PERSON_PORTRAIT()

    !$descriptor = $str2json($serialized_descriptor, $without_quotes = %true())
    !$params = $resolve_person_render_params($descriptor, $decorator)
    $render_c4_element($alias, $params)
!endprocedure
''----------------------------------------------------------------------------------------------------------------------
'' Рендерит элемент типа System в нотации C4 Context.
!procedure $render_system($alias, $serialized_descriptor, $decorator)
    !$descriptor = $str2json($serialized_descriptor, $without_quotes = %true())
    !$params = $resolve_system_render_params($descriptor, $decorator)
    $render_c4_element($alias, $params)
!endprocedure
!procedure $render_c4_element($alias, $params)
    !if $params.is_extern == %true()
        !$render_proc_name = $format("%1_Ext", $params.render_proc)
    !else
       !$render_proc_name = $params.render_proc
    !endif

    %invoke_procedure(\
        $render_proc_name, \
        $alias, \
        $params.label, \
        $default($params.desc), \
        $default($params.sprite), \
        $default($params.tags), \
        $default($params.link), \
        $default($params.type) \
    )
!endprocedure
''----------------------------------------------------------------------------------------------------------------------
'' Вычисляет параметры рендеринга для C4-элемента на основе дескриптора и декоратора.
'' Чистая функция: не имеет побочных эффектов, всегда возвращает одинаковый результат при одинаковых аргументах.
'' args: $descriptor - JSON-объект {type, label, desc, sprite, tags, link, element_type, reason, reason_source}
''       $decorator - JSON-объект {is_extern, show_desc, sprite, styles}
''       $render_proc - имя нативной функции рендеринга ("Person", "System", "SystemQueue", "SystemDb")
'' returns: JSON-объект {label, desc, sprite, render_proc, tags, type, link, is_extern} — вычисленные параметры для нативного рендеринга
!function $resolve_c4_element_render_params($descriptor, $decorator, $render_proc)
    !$params = {}

    !$params = $json_add($params, "label", $descriptor.label)

    !$params = $json_add($params, "desc", $value_or_default($decorator.show_desc == %true(), $descriptor.desc))

    !$decor_sprite = $default($decorator.sprite)
    !if $decor_sprite != ""
        !$params = $json_add($params, "sprite", $decor_sprite)
    !else
        !$params = $json_add($params, "sprite", $default($descriptor.sprite))
    !endif

    !$params = $json_add($params, "render_proc", $render_proc)

    !$params = $json_add($params, "tags", $combine_tags($default($descriptor.tags), $array2str($decorator.styles, "+")))

    !$params = $json_add($params, "type", $default($descriptor.element_type))

    !$params = $json_add($params, "link", $default($descriptor.link))

    !$params = $json_add($params, "is_extern", $decorator.is_extern)

    !return $params
!endfunction
''----------------------------------------------------------------------------------------------------------------------
'' Вычисляет параметры рендеринга для элемента Person.
'' Обёртка над $resolve_c4_element_render_params.
!function $resolve_person_render_params($descriptor, $decorator)
    !return $resolve_c4_element_render_params($descriptor, $decorator, "Person")
!endfunction
''----------------------------------------------------------------------------------------------------------------------
'' Вычисляет параметры рендеринга для элемента System.
'' Маппинг element_type → нативная функция:
''   "Queue" → SystemQueue, "Db" → SystemDb, иначе → System
!function $resolve_system_render_params($descriptor, $decorator)
    !$etype = $default($descriptor.element_type)
    '' NOTE: Не используем $resolve_c4_element_render_params напрямую, т.к. нужен маппинг $etype
    !$params = {}

    !$params = $json_add($params, "label", $descriptor.label)

    !$params = $json_add($params, "desc", $value_or_default($decorator.show_desc == %true(), $descriptor.desc))

    !$decor_sprite = $default($decorator.sprite)
    !if $decor_sprite != ""
        !$params = $json_add($params, "sprite", $decor_sprite)
    !else
        !$params = $json_add($params, "sprite", $default($descriptor.sprite))
    !endif

    '' Маппинг element_type → render_proc
    !if $etype == "Queue"
        !$params = $json_add($params, "render_proc", "SystemQueue")
        !$params = $json_add($params, "type", "")
    !elseif $etype == "Db"
        !$params = $json_add($params, "render_proc", "SystemDb")
        !$params = $json_add($params, "type", "")
    !else
        !$params = $json_add($params, "render_proc", "System")
        !$params = $json_add($params, "type", $etype)
    !endif

    !$params = $json_add($params, "tags", $combine_tags($default($descriptor.tags), $array2str($decorator.styles, "+")))

    !$params = $json_add($params, "link", $default($descriptor.link))

    !$params = $json_add($params, "is_extern", $decorator.is_extern)

    !return $params
!endfunction
''----------------------------------------------------------------------------------------------------------------------
'' Создаёт дескриптор связи C4 Relation.
'' args: $from - алиас исходного элемента
''       $to - алиас целевого элемента
''       $label - отображаемая метка связи
''       $techn - технология (опционально)
''       $descr - описание (опционально)
''       $tags - теги (опционально)
''       $reason - обоснование присутствия связи в архитектуре (опционально)
''       $reason_source - источник обоснования: требование, документ, глоссарий (опционально)
'' returns: JSON-объект {type, from, to, label, techn, descr, tags, reason, reason_source}
!function $default_relation_descriptor($from, $to, $label, $techn="", $descr="", $tags="", $reason="", $reason_source="")
    !$descriptor = {}
    !$descriptor = $json_add($descriptor, "type", "Relation")
    !$descriptor = $json_add($descriptor, "from", $from)
    !$descriptor = $json_add($descriptor, "to", $to)
    !$descriptor = $json_add($descriptor, "label", $label)
    !$descriptor = $json_add($descriptor, "techn", $techn)
    !$descriptor = $json_add($descriptor, "descr", $descr)
    !$descriptor = $json_add($descriptor, "tags", [])
    !$descriptor = $json_add($descriptor, "reason", $reason)
    !$descriptor = $json_add($descriptor, "reason_source", $reason_source)
    !return $descriptor
!endfunction
''----------------------------------------------------------------------------------------------------------------------
'' Создаёт декоратор связи со значениями по умолчанию.
'' returns: JSON-объект {show_label, show_techn, show_descr, link, sprite, styles}
!function $default_relation_decorator()
    !$decorator = {}
    !$decorator = $json_add($decorator, "show_label", %true())
    !$decorator = $json_add($decorator, "show_techn", %true())
    !$decorator = $json_add($decorator, "show_descr", %true())
    !$decorator = $json_add($decorator, "link", "")
    !$decorator = $json_add($decorator, "sprite", "")
    !$decorator = $json_add($decorator, "styles", [])
    !return $decorator
!endfunction
''----------------------------------------------------------------------------------------------------------------------
'' Регистрирует связь между элементами.
'' Создаёт дескриптор (атрибуты) и сохраняет его в глобальный реестр.
'' Декоратор создаётся при включении в диаграмму командой Relations().
'' args: $alias - уникальный алиас связи
''       $from - алиас исходного элемента
''       $to - алиас целевого элемента
''       $label - отображаемая метка связи
''       $techn - технология (опционально)
''       $descr - описание (опционально)
''       $tags - теги (опционально)
''       $reason - обоснование присутствия связи в архитектуре (опционально)
''       $reason_source - источник обоснования: требование, документ, глоссарий (опционально)
'' example: $Relation("User-ERP", "User", "ERP", "Использует", "HTTPS", "Основной канал работы", "critical")
!unquoted procedure $Relation($alias, $from, $to, $label, $techn="", $descr="", $tags="", $reason="", $reason_source="")
    !$descriptor = $default_relation_descriptor($from, $to, $label, $techn, $descr, $tags, $reason, $reason_source)
    $register_descriptor($alias, $json2str($descriptor, %true()))
!endprocedure
''----------------------------------------------------------------------------------------------------------------------
'' Внутренняя реализация включения связей в диаграмму.
!unquoted procedure $include_relations($source, $aliases)
    !if $source != ""
        !foreach $alias in %splitstr($aliases, " ")
            !$relation_file = $format("%1/%2.relation.puml", $source, $alias)
            !include $relation_file

            !$decorator = $default_relation_decorator()
            $register_decorator($alias, $decorator)

            $add_to_rendering_queue($alias)
        !endfor
    !endif
!endprocedure
''----------------------------------------------------------------------------------------------------------------------
'' Включает зарегистрированные связи в текущую диаграмму.
'' Добавляет алиасы в очередь рендеринга.
'' args: $source - путь к каталогу с объявлениями связей.
''       $aliases - перечисление алиасов связей (разделенные пробелом).
'' example: Relations("Relations", User-ERP ERP-1C)
!unquoted procedure Relations($source, $aliases)
    $include_relations($source, $aliases)
!endprocedure
''----------------------------------------------------------------------------------------------------------------------
'' Вычисляет параметры рендеринга для связи Relation на основе дескриптора и декоратора.
'' Чистая функция: не имеет побочных эффектов.
'' args: $descriptor - JSON-объект {type, from, to, label, techn, descr, tags}
''       $decorator - JSON-объект {show_label, show_techn, show_descr, link, sprite, styles}
'' returns: JSON-объект {from, to, label, techn, descr, sprite, link, tags}
!function $resolve_relation_render_params($descriptor, $decorator)
    !$params = {}

    !$params = $json_add($params, "from", $descriptor.from)
    !$params = $json_add($params, "to", $descriptor.to)

    !$params = $json_add($params, "label", $value_or_default($decorator.show_label == %true(), $descriptor.label))
    !$params = $json_add($params, "techn", $value_or_default($decorator.show_techn == %true(), $descriptor.techn))
    !$params = $json_add($params, "descr", $value_or_default($decorator.show_descr == %true(), $descriptor.descr))

    !$params = $json_add($params, "sprite", $decorator.sprite)
    !$params = $json_add($params, "link", $decorator.link)

    !$params = $json_add($params, "tags", $array2str($decorator.styles, "+"))

    !return $params
!endfunction
''----------------------------------------------------------------------------------------------------------------------
'' Рендерит связь в нотации C4 Context.
'' Десериализует дескриптор, вычисляет параметры с учётом декоратора,
'' затем вызывает стандартную функцию Rel().
'' args: $alias - алиас связи
''       $serialized_descriptor - дескриптор связи {type, from, to, label, techn, descr, tags}
''       $decorator - декоратор связи {show_label, show_techn, show_descr, link, sprite, styles}
!procedure $render_relation($alias, $serialized_descriptor, $decorator)
    !$descriptor = $str2json($serialized_descriptor, $without_quotes = %true())
    !$params = $resolve_relation_render_params($descriptor, $decorator)

    %invoke_procedure(\
        "Rel", \
        $params.from, \
        $params.to, \
        $default($params.label), \
        $default($params.techn), \
        $default($params.descr), \
        $default($params.sprite), \
        $default($params.tags), \
        $default($params.link) \
    )
!endprocedure
''----------------------------------------------------------------------------------------------------------------------
@enduml
