@startuml
''----------------------------------------------------------------------------------------------------------------------
'' Возвращает версию библиотеки PlantUml DSL.
'' example: !$ver = $get_library_version()
!function $get_library_version()
    !if %file_exists("../version.json")
        !$ver = %load_json("../version.json")
    !else if %file_exists("version.json")
        !$ver = %load_json("version.json")
    !endif
    !return $ver.version
!endfunction
''----------------------------------------------------------------------------------------------------------------------
'' Печатает трассировочные сообщения в виде таблицы прямо на диаграмму.
!procedure $trace($message, $source="")
    !$TRACE_MESSAGES = "log_messages"
    !if $source == ""
        !$source = %filename()
    !endif

    !if (%not(%variable_exists($TRACE_MESSAGES)))
        $__init_trace_log($TRACE_MESSAGES)
    !endif

    !$log_messages = %get_variable_value($TRACE_MESSAGES)

    !if %mod(%size($log_messages), 2) == 0
        !$row_color = "<#f0f0f0>"
    !else
        !$row_color = "<#white>"
    !endif

    !$current_row_number = %size($log_messages)

    !$log_row = $format('%1| %2 | %3 | %4 |', $row_color, $current_row_number, $message, $source)
    !$log_messages = $append_to_list($log_messages, $log_row)
    %set_variable_value($TRACE_MESSAGES, $log_messages)

    title
    Трассировочные сообщения:
    !foreach $row in $log_messages
    $row
    !endfor
    end title
!endprocedure
''----------------------------------------------------------------------------------------------------------------------
!procedure $trace_clear()
    $__init_trace_log("log_messages")
!endprocedure
''----------------------------------------------------------------------------------------------------------------------
!procedure $__init_trace_log($msg_list)
    !$log_messages = [\
        "<#lightyellow>|= # |= Message |= Source |"\
    ]
    %set_variable_value($msg_list, $log_messages)
!endprocedure
''----------------------------------------------------------------------------------------------------------------------
'' Подставляет значения параметров в шаблон по меткам %1–%8 (аналог sprintf).
'' example: !$text = $format("This is %1 with arguments %2 and %3.", "expression", "x", "y")
!function $format($text, $p1, $p2="", $p3="", $p4="", $p5="", $p6="", $p7="", $p8="")
    !$result = ""

    !foreach $fragment in %splitstr($text, "%")
        !if (%substr($fragment, 0, 1) == "1")
            !$result = $result + $p1 + %substr($fragment, 1, %strlen($fragment) - 1)
        !elseif (%substr($fragment, 0, 1) == "2")
            !$result = $result + $p2 + %substr($fragment, 1, %strlen($fragment) - 1)
        !elseif (%substr($fragment, 0, 1) == "3")
            !$result = $result + $p3 + %substr($fragment, 1, %strlen($fragment) - 1)
        !elseif (%substr($fragment, 0, 1) == "4")
            !$result = $result + $p4 + %substr($fragment, 1, %strlen($fragment) - 1)
        !elseif (%substr($fragment, 0, 1) == "5")
            !$result = $result + $p5 + %substr($fragment, 1, %strlen($fragment) - 1)
        !elseif (%substr($fragment, 0, 1) == "6")
            !$result = $result + $p6 + %substr($fragment, 1, %strlen($fragment) - 1)
        !elseif (%substr($fragment, 0, 1) == "7")
            !$result = $result + $p7 + %substr($fragment, 1, %strlen($fragment) - 1)
        !elseif (%substr($fragment, 0, 1) == "8")
            !$result = $result + $p8 + %substr($fragment, 1, %strlen($fragment) - 1)
        !else
            !$result = $result + $fragment
        !endif
    !endfor

    !return $result
!endfunction
''----------------------------------------------------------------------------------------------------------------------
'' Проверяет, входит ли элемент в коллекцию.
'' args: $collection - JSON-массив для поиска
''       $item - искомый элемент
'' returns: %true() если $item найден в $collection, иначе %false()
'' example: !$found = $contain_in_list($my_array, "target_value")
!function $contain_in_list($collection, $item)
    !foreach $e in $collection
        !if $e == $item
            !return %true()
        !endif
    !endfor
    !return %false()
!endfunction
''----------------------------------------------------------------------------------------------------------------------
'' Добавляет элемент в конец JSON-массива и возвращает изменённый массив.
'' args: $collection - JSON-массив, к которому добавляется элемент
''       $item - JSON-объект, строка или число
'' returns: новый JSON-массив с элементом $item в конце
'' example: !$extended = $append_to_list($my_array, "new_value")
!function $append_to_list($collection, $item)
    !$str = %string($collection)
    !$len = %strlen($str)
    !$json_item = $__serialize_json_value($item)
    !if $len == 2
        !return %str2json($format("[%1]", $json_item))
    !endif
    !$without_bracket = %substr($str, 0, $len - 1)
    !$with_item = $format("%1, %2]", $without_bracket, $json_item)
    !return %str2json($with_item)
!endfunction
''----------------------------------------------------------------------------------------------------------------------
'' Добавляет пару ключ-значение в JSON-объект и возвращает изменённый объект.
'' args: $json - JSON-объект, в который добавляется пара
''       $key - имя ключа (строка)
''       $value - JSON-объект, строка, число, булево или null
'' returns: новый JSON-объект с добавленной парой
'' example: !$obj = $json_add($obj, "name", "Alice")
!function $json_add($json, $key, $value)
    !$str = %string($json)
    !$len = %strlen($str)

    !$json_value = $__serialize_json_value($value)

    !$json_key = $format('"%1"', $key)

    !if $len == 2
        !return %str2json($format("{%1: %2}", $json_key, $json_value))
    !endif

    !$without_brace = %substr($str, 0, $len - 1)
    !return %str2json($format("%1, %2: %3}", $without_brace, $json_key, $json_value))

!endfunction
''----------------------------------------------------------------------------------------------------------------------
'' Устанавливает или заменяет пару ключ-значение в JSON-объекте и возвращает изменённый объект.
'' args: $json - JSON-объект для обновления
''       $key - имя ключа (строка)
''       $value - JSON-объект, строка, число, булево или null
'' returns: новый JSON-объект с установленной парой
'' example: !$obj = $json_set($obj, "name", "Alice")
!function $json_set($json, $key, $value)
    !$str = %string($json)
    !$json_key = $format('"%1"', $key)
    !$key_pos = %strpos($str, $json_key)

    !if $key_pos < 0
        !return $json
    !endif

    !$json_value = $__serialize_json_value($value)
    !$key_len = %strlen($json_key)

    !$before = %substr($str, 0, $key_pos)

    !$after_key = %substr($str, $key_pos + $key_len + 2)
    !$close = %strpos($after_key, "}")
    !$comma = %strpos($after_key, ",")
    !if $comma >= 0
        !$value_end = $comma
    !else
        !$value_end = $close
    !endif

    !$after = %substr($after_key, $value_end)

    !return %str2json($format("%1%2: %3%4", $before, $json_key, $json_value, $after))
!endfunction
''----------------------------------------------------------------------------------------------------------------------
'' Принудительно прерывает выполнение с ошибкой.
'' args: $message - сообщение об ошибке
''       $source - имя исходного файла (по умолчанию %filename())
'' example: $fail("Something went wrong")
!procedure $fail($message, $source=%filename())
    !assert %false() : $format('FAIL: "%1" in "%2"', $message, $source)
!endprocedure
''----------------------------------------------------------------------------------------------------------------------
'' Превращает JSON-объект сложной структуры в строку.
'' args: $json - JSON-объект
''       $without_quotes - если %true(), имена ключей и строковые значения выводятся без кавычек (default: %false())
'' example: $text = $json2str($object)
'' example: $text = $json2str($object, %true())
!function $json2str($json, $without_quotes = %false())
    !$raw = %string($json)
    !$len = %strlen($raw)
    !$result = ""
    !$i = 0
    !$inside = %false()
    !while $i < $len
        !$ch = %substr($raw, $i, 1)
        !if $ch == '"'
            !if $inside == %true()
                !$inside = %false()
            !else
                !$inside = %true()
            !endif
            !if $without_quotes == %true()
                !$i = $i + 1
            !else
                !$result = $format("%1%2", $result, $ch)
                !$i = $i + 1
            !endif
        !elseif $ch == " " && $inside == %false()
            !$i = $i + 1
        !else
            !$result = $format("%1%2", $result, $ch)
            !$i = $i + 1
        !endif
    !endwhile
    !return $result
!endfunction
''----------------------------------------------------------------------------------------------------------------------
'' Превращает строку в JSON-объект.
'' При этом строка может содержать как валидное JSON-представление (атрибуты и их значения в кавычках),
'' так и представление без кавычек - это необходимо для обхода бага ядра PlantUml с хранением JSON в переменных.
'' args: $text - строковое представление JSON-объекта
''       $without_quotes - если %true(), ключи и значения в строке без кавычек (default: %false())
'' example: !$json = $str2json('{"Name":"Vassily","Age":"98"}')
'' example: !$json = $str2json("{Name:Vassily,Age:98}", %true())
!function $str2json($text, $without_quotes = %false())
    !if $without_quotes == %true()
        !$len = %strlen($text)
        !$inner = %substr($text, 1, $len - 2)
        !$pairs = %splitstr_regex($inner, ",")
        !$result_str = "{"
        !$first = %true()
        !foreach $pair in $pairs
            !$colon_pos = %strpos($pair, ":")
            !$key = %substr($pair, 0, $colon_pos)
            !$value = %substr($pair, $colon_pos + 1)
            !if $first == %true()
                !$first = %false()
                !$result_str = $format('%1"%2":"%3"', $result_str, $key, $value)
            !else
                !$result_str = $format('%1,"%2":"%3"', $result_str, $key, $value)
            !endif
        !endfor
        !$result_str = $format("%1}", $result_str)
        !return %str2json($result_str)
    !else
        !return %str2json($text)
    !endif
!endfunction
''----------------------------------------------------------------------------------------------------------------------
'' Сериализует значение в JSON-совместимое строковое представление.
'' Если значение уже является JSON-литералом (число, булево, null, объект, массив, строка в кавычках),
'' возвращает его без изменений; иначе оборачивает в двойные кавычки.
'' args: $value - любое значение PlantUML
'' returns: JSON-совместимое строковое представление
'' example: !$json_val = $__serialize_json_value("hello")
!function $__serialize_json_value($value)
    !$raw = %string($value)
    !if $raw == ""
        !return '"__EMPTY__"'
    !endif
    !$first_char = %substr($raw, 0, 1)
    !if $raw == "true" || $raw == "false" || $raw == "null"
        !return $raw
    !elseif $first_char == "{" || $first_char == "["
        !return $raw
    !elseif $first_char == '"'
        !return $raw
    !elseif %strpos("0123456789", $first_char) >= 0 || $first_char == "-" || $first_char == "."
        !return $raw
    !else
        !return $format('"%1"', $raw)
    !endif
!endfunction
''----------------------------------------------------------------------------------------------------------------------
'' Превращает маркер пустой строки обратно в пустую строку.
'' args: $value - строковое значение
'' returns: "" если $value == "__EMPTY__", иначе $value без изменений
!function $default($value)
    !if $value == "__EMPTY__"
        !return ""
    !endif
    !return $value
!endfunction
''----------------------------------------------------------------------------------------------------------------------
!function $value_or_default($condition, $value, $default="")
    !if $condition == %true()
        !return $value
    !else
        !return $default
    !endif
!endfunction
''----------------------------------------------------------------------------------------------------------------------
!function $array2str($array, $splitter=",")
    !$result = ""
    !$first = %true()
    !foreach $item in $array
        !if $first == %true()
            !$result = $format("%1", $item)
            !$first = %false()
        !else
            !$result = $format("%1%2%3", $result, $splitter, $item)
        !endif
    !endfor
    !return $result
!endfunction
''----------------------------------------------------------------------------------------------------------------------
'' Объединяет два набора тегов через разделитель "+".
'' Используется для комбинирования тегов из дескриптора и стилей из декоратора.
'' args: $a - первый набор тегов (строка, может быть "")
''       $b - второй набор тегов (строка, может быть "")
'' returns: объединённая строка тегов с разделителем "+"
'' example: !$tags = $combine_tags("critical,external", "alert")
!function $combine_tags($a, $b)
    !if $a != "" && $b != ""
        !return $format("%1+%2", $a, $b)
    !elseif $a != ""
        !return $a
    !elseif $b != ""
        !return $b
    !else
        !return ""
    !endif
!endfunction
''----------------------------------------------------------------------------------------------------------------------
@enduml
