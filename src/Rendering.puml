@startuml
!include Utils.puml
!include Common.puml
''----------------------------------------------------------------------------------------------------------------------
'' Модуль рендеринга диаграмм.
'' Содержит общие (не привязанные к конкретной нотации) процедуры:
'' настройка опций отображения элементов и оркестрация рендеринга.
'' Зависимости: Utils.puml, Common.puml
''----------------------------------------------------------------------------------------------------------------------
'' Скрывает описание (desc/descr) элемента при рендеринге.
'' Работает как для элементов (show_desc), так и для связей (show_descr).
'' args: $element - алиас элемента
'' example: HideDescription(User)
!unquoted procedure HideDescription($element)
    $update_decorator($element, "show_desc", %false())
    $update_decorator($element, "show_descr", %false())
!endprocedure
''----------------------------------------------------------------------------------------------------------------------
'' Скрывает метку (label) элемента при рендеринге.
'' Применяется в основном к связям (Relation).
'' args: $element - алиас элемента
'' example: HideLabel(User-ERP)
!unquoted procedure HideLabel($element)
    $update_decorator($element, "show_label", %false())
!endprocedure
''----------------------------------------------------------------------------------------------------------------------
'' Скрывает технологию (techn) элемента при рендеринге.
'' Применяется в основном к связям (Relation).
'' args: $element - алиас элемента
'' example: HideTechnology(User-ERP)
!unquoted procedure HideTechnology($element)
    $update_decorator($element, "show_techn", %false())
!endprocedure
''----------------------------------------------------------------------------------------------------------------------
'' Добавляет визуальный стиль к элементу (без дубликатов).
'' args: $element - алиас элемента
''       $style - имя стиля (строка)
'' example: ApplyStyle(User, "bright_and_bold")
!unquoted procedure ApplyStyle($element, $style)
    !$decorator = $get_decorator($element)
    !$styles = $decorator.styles
    !if %not($contain_in_list($styles, $style))
        !$styles = $append_to_list($styles, $style)
        !$decorator = $json_set($decorator, "styles", $styles)
        $register_decorator($element, $decorator)
    !endif
!endprocedure
''----------------------------------------------------------------------------------------------------------------------
'' Устанавливает спрайт для элемента.
'' Применяется как к элементам (Person), так и к связям (Relation).
'' args: $element - алиас элемента
''       $sprite - имя спрайта (строка)
'' example: ApplySprite(User-Admin, "robot")
!unquoted procedure ApplySprite($element, $sprite)
    $update_decorator($element, "sprite", $sprite)
!endprocedure
''----------------------------------------------------------------------------------------------------------------------
'' Выполняет рендеринг диаграммы: обходит очередь рендеринга и для каждого элемента
'' вызывает диспетчер, который по типу элемента выбирает процедуру рендеринга.
'' После рендеринга очищает очередь.
'' args: $title - заголовок диаграммы (строка)
'' example: Diagram("System Context diagram")
!procedure Diagram($title)
    caption
    $title
    end caption

    !$rendering_queue = $get_rendering_queue()
    !$boundary_groups = $get_boundary_groups()

    '' Собираем список алиасов, входящих в группы
    !$grouped_aliases = []
    !foreach $group in $boundary_groups
        !foreach $a in $group.aliases
            !if $contain_in_list($grouped_aliases, $a) == %false()
                !$grouped_aliases = $append_to_list($grouped_aliases, $a)
            !endif
        !endfor
    !endfor

    '' Рендерим группы ПЕРВЫМИ: открываем Boundary, рендерим элементы внутри, закрываем
    !foreach $group in $boundary_groups
        !$native_proc = $resolve_boundary_native_proc($default($group.b_type))
        $emit_boundary_open( \
            $native_proc, \
            $group.b_alias, \
            $group.label, \
            $default($group.sprite), \
            $default($group.tags), \
            $default($group.link) \
        )
        !foreach $alias in $group.aliases
            !$descriptor = $get_descriptor($alias)
            !$decorator = $get_decorator($alias)
            $render_dispatch($alias, $descriptor, $decorator)
        !endfor
        $emit_boundary_close()
    !endfor

    '' Затем рендерим негруппированные элементы (включая Relations)
    !foreach $alias in $rendering_queue
        !if $contain_in_list($grouped_aliases, $alias) == %false()
            !$descriptor = $get_descriptor($alias)
            !$decorator = $get_decorator($alias)
            $render_dispatch($alias, $descriptor, $decorator)
        !endif
    !endfor

    $reset_rendering_queue()
    $reset_boundary_groups()
!endprocedure
''----------------------------------------------------------------------------------------------------------------------
'' Диспетчер рендеринга: выбирает процедуру рендеринга по типу элемента.
'' args: $alias - алиас элемента
''       $descriptor - JSON-объект атрибутов элемента
''       $decorator - JSON-объект опций отображения элемента
'' example: $render_dispatch("User", $desc, $decor)
!procedure $render_dispatch($alias, $descriptor, $decorator)
    !$unwrapped_descriptor = $str2json($descriptor, $without_quotes = %true())
    !$element_type = $unwrapped_descriptor.type

    !$render_proc_key = $format("RENDER_PROC_%1", $element_type)
    !if %variable_exists($render_proc_key) == %true()
        !$render_proc = %get_variable_value($render_proc_key)
        %invoke_procedure($render_proc, $alias, $descriptor, $decorator)
    !endif

!endprocedure
''----------------------------------------------------------------------------------------------------------------------
'' Регистрирует процедуру рендеринга для заданного типа элемента.
'' Вызывается модулями (C4, Data, ...) при загрузке на верхнем уровне файла.
'' При повторной регистрации того же типа молча сохраняет первый вариант (first wins).
'' args: $element_type - тип элемента (строка, напр. "Person", "Relation")
''       $proc - имя процедуры рендеринга (строка, с префиксом $)
'' example: $register_rendering_proc("Person", $proc="$render_person")
!procedure $register_rendering_proc($element_type, $proc)
    !$key = $format("RENDER_PROC_%1", $element_type)
    !if %variable_exists($key) == %false()
        %set_variable_value($key, $proc)
    !endif
!endprocedure
'----------------------------------------------------------------------------------------------------------------------
@enduml
